<script>
document.addEventListener('DOMContentLoaded', function () {
  const forceUppercaseSelect = (selectEl) => {
    if (!selectEl) return;
    const options = Array.from(selectEl.options || []);
    options.forEach((opt) => {
      const rawText = (opt.textContent || '').trim();
      if (!rawText) return;
      const upper = rawText.toUpperCase();
      if (opt.textContent !== upper) opt.textContent = upper;
      if (opt.label !== upper) opt.label = upper;
      opt.setAttribute('title', upper);
    });
    const labelEl = selectEl.closest('.ph-pdp-option-groupsize')?.querySelector('.ph-pdp-option-title');
    const labelText = (labelEl?.textContent || '').trim();
    if (labelText) {
      const upperLabel = labelText.toUpperCase();
      selectEl.setAttribute('aria-label', upperLabel);
      selectEl.setAttribute('title', upperLabel);
    }
  };
  const forceUppercaseAllProductSelects = () => {
    document.querySelectorAll('.ph-pdp-product-container select, #phStickyBar select').forEach((selectEl) => {
      forceUppercaseSelect(selectEl);
    });
  };
  forceUppercaseAllProductSelects();
  const mainBtn   = document.querySelector('.ph-pdp-add-to-cart-button');
  const notifyBtn = document.getElementById('notify-button');
  const stickyBar = document.getElementById('phStickyBar');
  const stickyBtn = document.getElementById('phStickyAddToCart');
  const stickySel = document.getElementById('phStickySizeSelect'); // may be null
  const stickyLetterSel = document.getElementById('phStickyLetterCharmSelect'); // may be null
  if (!stickyBar || !stickyBtn) return;
  if (stickySel) {
    const wrap = stickySel.parentElement; // <span class="ph-sticky-select-wrap">
    stickySel.addEventListener('mousedown',  () => wrap.classList.add('is-open'));
    stickySel.addEventListener('touchstart', () => wrap.classList.add('is-open'), { passive: true });
    stickySel.addEventListener('change',   () => {
      wrap.classList.remove('is-open');
      forceUppercaseSelect(stickySel);
    });
    stickySel.addEventListener('blur',     () => wrap.classList.remove('is-open'));
    forceUppercaseSelect(stickySel);
  }
  if (stickyLetterSel) {
    const wrap = stickyLetterSel.parentElement;
    stickyLetterSel.addEventListener('mousedown',  () => wrap.classList.add('is-open'));
    stickyLetterSel.addEventListener('touchstart', () => wrap.classList.add('is-open'), { passive: true });
    stickyLetterSel.addEventListener('change',   () => {
      wrap.classList.remove('is-open');
      forceUppercaseSelect(stickyLetterSel);
    });
    stickyLetterSel.addEventListener('blur',     () => wrap.classList.remove('is-open'));
    forceUppercaseSelect(stickyLetterSel);
  }
  document.body.appendChild(stickyBar);
  document.body.classList.add('has-sticky-add');
  const updateVariantSelection =
    typeof window.updateVariantSelection === 'function' ? window.updateVariantSelection : () => {};
  const notifyIsVisible = () =>
    !!(notifyBtn && !notifyBtn.classList.contains('hidden') && notifyBtn.offsetParent);
	  const isCartOpen = () => {
	    const cd = document.querySelector('cart-drawer');
	    const nativeOpen = cd && (cd.classList.contains('active') || cd.hasAttribute('open'));
	    const bodyLocked =
	      document.body.classList.contains('overflow-hidden') ||
	      document.body.classList.contains('cart-overflow-hidden');
	    const legacy = document.getElementById('CartDrawer');
	    const legacyOpen = legacy && legacy.classList.contains('active');
	    return !!(nativeOpen || bodyLocked || legacyOpen);
	  };
	  const consentBannerIsVisible = () => {
	    const banner = document.querySelector('#shopify-pc__banner, .shopify-pc__banner__dialog');
	    if (!banner) return false;
	    const styles = window.getComputedStyle(banner);
	    if (styles.display === 'none' || styles.visibility === 'hidden' || styles.opacity === '0') return false;
	    const rect = banner.getBoundingClientRect();
	    return rect.width > 0 && rect.height > 0;
	  };
  function syncState() {
    if (notifyIsVisible()) {
      stickyBtn.disabled = false;
      stickyBtn.textContent = notifyBtn.textContent || 'Notify me';
      stickyBtn.dataset.mode = 'notify';
    } else {
      const disabled = !!(mainBtn && mainBtn.disabled);
      stickyBtn.disabled = disabled;
      stickyBtn.style.opacity = disabled ? '0.65' : '1';
      stickyBtn.textContent = (mainBtn && mainBtn.textContent?.trim()) || 'ADD TO BASKET';
      stickyBtn.dataset.mode = 'add';
    }
    if (stickySel) {
      const hiddenInput = document.getElementById(`Option${stickySel.dataset.optionIndex}`);
      const hasMatchingOption = hiddenInput && hiddenInput.value && Array.from(stickySel.options).some((opt) => opt.value === hiddenInput.value);
      if (hasMatchingOption) {
        stickySel.value = hiddenInput.value;
        forceUppercaseSelect(stickySel);
      }
    }
  }
  syncState();
  if (mainBtn) {
    new MutationObserver(() => { syncState(); toggleVisibility(); }).observe(mainBtn, {
      attributes: true, attributeFilter: ['disabled', 'class', 'style'], childList: true, subtree: true
    });
  }
  if (notifyBtn) {
    new MutationObserver(() => { syncState(); toggleVisibility(); }).observe(notifyBtn, {
      attributes: true, attributeFilter: ['class', 'style'], childList: true, subtree: true
    });
  }
  const scrollTopForStickySelection = () => {
    if (window.innerWidth >= 1024) return;
    const doScroll = () => window.scrollTo({ top: 0, behavior: 'smooth' });
    doScroll();
    requestAnimationFrame(() => setTimeout(doScroll, 40));
  };
  if (stickySel) {
    stickySel.addEventListener('change', () => {
      const idx = +stickySel.dataset.optionIndex;
      const hiddenInput = document.getElementById(`Option${idx}`);
      if (hiddenInput) {
        hiddenInput.value = stickySel.value;
        document.querySelectorAll('.ph-pdp-size-box[data-option-value]').forEach(el => {
          el.classList.toggle('selected', el.dataset.optionValue === stickySel.value);
        });
        updateVariantSelection(idx, stickySel.value);
        if (!stickyLetterSel) scrollTopForStickySelection();
      }
    });
  }
	  stickyBtn.addEventListener('click', (e) => {
	    e.preventDefault();
	    const mode = stickyBtn.dataset.mode ||
	      (typeof window.__phStickyMode === 'function' ? window.__phStickyMode() : 'add');
	    if (mode === 'notify') {
	      notifyBtn?.click();     // opens your BIS modal
	    } else {
	      const form = mainBtn?.closest('form') || document.querySelector('form[action*="/cart/add"]');
	      if (form?.requestSubmit && mainBtn) {
	        form.requestSubmit(mainBtn);
	      } else if (form) {
	        const submitEvent = typeof SubmitEvent === 'function'
	          ? new SubmitEvent('submit', { bubbles: true, cancelable: true, submitter: mainBtn || undefined })
	          : new Event('submit', { bubbles: true, cancelable: true });
	        form.dispatchEvent(submitEvent);
	      } else {
	        mainBtn?.click();
	      }
	    }
	  });
  const getActiveCta = () => (notifyIsVisible() ? notifyBtn : mainBtn);
	  function toggleVisibility() {
	    const cta = getActiveCta();
	    if (!cta) return;
	    const r = cta.getBoundingClientRect();
	    const anyPartVisible = r.height > 0 && r.top < window.innerHeight && r.bottom > 0;
	    const isMobile = window.innerWidth < 768;
	    const hasStartedScrolling = window.scrollY > 8;
	    const ctaHasPassed = r.height > 0 && r.bottom <= 0;
	    const shouldSummarize = false;
	    const shouldHide =
	      isCartOpen() ||
	      consentBannerIsVisible() ||
	      (isMobile ? (hasStartedScrolling && !ctaHasPassed) : anyPartVisible);
	    stickyBar.classList.toggle('is-summary-only', shouldSummarize && !shouldHide);
	    stickyBar.classList.toggle('is-hidden', shouldHide);
	    window.phPdpFitStickySummaryCopy?.();
	  }
	  window.phPdpToggleStickyVisibility = toggleVisibility;
	  toggleVisibility();
	  window.addEventListener('scroll', toggleVisibility, { passive: true });
	  window.addEventListener('resize', toggleVisibility);
	  new MutationObserver((mutations) => {
	    const onlyStickyBarMutations = mutations.every((mutation) => {
	      const target = mutation.target;
	      return target instanceof Element && target.closest('#phStickyBar');
	    });
	    if (!onlyStickyBarMutations) toggleVisibility();
	  }).observe(document.body, {
	    attributes: true,
	    childList: true,
	    subtree: true,
	    attributeFilter: ['class', 'style', 'hidden', 'aria-hidden']
	  });
	});
</script>
