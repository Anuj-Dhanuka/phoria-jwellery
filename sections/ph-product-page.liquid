  function normalizeStoneDisplayValue(rawValue) {
    if (Array.isArray(rawValue)) {
      return rawValue
        .map((entry) => String(entry || '').trim())
        .filter(Boolean)
        .join(', ');
    }
    const text = String(rawValue || '').trim();
    if (!text) return '';
    if (text.startsWith('[') && text.endsWith(']')) {
      try {
        const parsed = JSON.parse(text);
        if (Array.isArray(parsed)) {
          return parsed
            .map((entry) => String(entry || '').trim())
            .filter(Boolean)
            .join(', ');
        }
      } catch (error) {
      }
    }
    return text.replace(/^\[/, '').replace(/\]$/, '').replace(/"/g, '').replace(/'/g, '').trim();
  }
  function normalizePriceToCents(rawPrice) {
    if (rawPrice === null || rawPrice === undefined || rawPrice === '') return 0;
    if (typeof rawPrice === 'number') {
      if (Number.isFinite(rawPrice) && rawPrice > 0 && rawPrice < 1000 && !Number.isInteger(rawPrice)) {
        return Math.round(rawPrice * 100);
      }
      return Math.round(rawPrice);
    }
    const text = String(rawPrice).trim();
    if (!text) return 0;
    if (text.includes('.')) {
      const asUnits = Number(text);
      if (Number.isFinite(asUnits)) return Math.round(asUnits * 100);
    }
    const asNumber = Number(text);
    if (!Number.isFinite(asNumber)) return 0;
    return Math.round(asNumber);
  }
