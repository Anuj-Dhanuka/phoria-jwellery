                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: itemsToAdd })
              });
              if (!response.ok) {
                throw new Error(`Network response was not ok: ${response.status}`);
              }
            } else {
            const baseProperties = {};
            for (const [key, value] of formData.entries()) {
              const match = /^properties\[(.+)\]$/.exec(String(key));
              if (!match) continue;
              baseProperties[match[1]] = value;
            }
            const sellingPlanId = formData.get('selling_plan');
            const sharedLcBundleKey = lcBundleKey || `phlc_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
            const isNoLetterSelection = selectedLetterCharm === 'NO LETTER';
            const baseItems = [];
            if (isDoubleBaseSelectorProduct) {
              const resolvedBaseVariant = await resolveDoubleBaseVariant();
              const doubleBaseVariantId = Number(resolvedBaseVariant?.id || 0);
              if (!doubleBaseVariantId) {
                throw new Error('Double-base selector base variant could not be resolved.');
              }
              const visibleProperties = {
                ...baseProperties,
                _lc_bundle_key: sharedLcBundleKey,
                _lc_parent_bundle: 'true',
                _letter_charm: selectedLetterCharm,
                _lc_display_title: activeDisplayTitle
              };
              const hiddenProperties = {
                ...baseProperties,
                _lc_bundle_key: sharedLcBundleKey,
                _lc_hidden_component: 'true',
                _lc_component_role: 'secondary_base',
                _letter_charm: selectedLetterCharm
              };
              baseItems.push({
                id: doubleBaseVariantId,
                quantity: addQuantity,
                properties: visibleProperties
              });
              baseItems.push({
                id: doubleBaseVariantId,
                quantity: addQuantity,
                properties: hiddenProperties
              });
            } else {
              let baseVariantId = Number(formData.get('id'));
              if (isChainSourceProduct && activeChainSourceConfig) {
                await prefetchChainSourcePrices();
                const sel = variants.find((v) => Number(v.id) === baseVariantId);
                const sz = resolveVariantSizeKey(sel);
                const mappedVariantId = resolveChainSourceVariantIdForSize(sz);
                baseVariantId = mappedVariantId || baseVariantId;
              }
              if (!baseVariantId) {
                throw new Error('Base variant id is missing from product form.');
              }
              const baseItem = {
                id: baseVariantId,
                quantity: addQuantity
              };
              if (Object.keys(baseProperties).length) {
                baseItem.properties = baseProperties;
              }
              baseItem.properties = baseItem.properties || {};
              baseItem.properties._lc_display_title = activeDisplayTitle;
              if (isChainSourceProduct && !isNoLetterSelection) {
                baseItem.properties._lc_parent_bundle = 'true';
                baseItem.properties._linked_parent_product = {{ product.title | json }};
                baseItem.properties._linked_parent_handle = {{ product.handle | json }};
              }
              baseItems.push(baseItem);
            }
            if (sellingPlanId) {
              baseItems.forEach((entry) => {
                entry.selling_plan = Number(sellingPlanId) || sellingPlanId;
              });
            }
            let pendantItem = null;
            if (
              letterCharmsEnabled
              && !isNoLetterSelection
              && letterPendantHandle
            ) {
              const letterProductData = await resolveAnywearLetterProductData();
              if (letterProductData) {
                const letterVariants = Array.isArray(letterProductData?.variants) ? letterProductData.variants : [];
                const letterVariant = findLetterVariantBySelection(
                  letterVariants,
                  selectedLetterCharm,
                  isChainSourceProduct
                );
                if (letterVariant) {
                  pendantItem = {
                    id: letterVariant.id,
                    quantity: addQuantity,
                    properties: {
                      _linked_parent_product: {{ product.title | json }},
                      _selected_letter: selectedLetterCharm,
                      _lc_bundle_key: sharedLcBundleKey
                    }
                  };
                } else {
                  console.warn(`No letter pendant variant found for letter "${selectedLetterCharm}"`);
                }
              } else {
                console.warn(`Could not load letter pendant product for handle "${letterPendantHandle}"`);
              }
            }
            const itemsToAdd = pendantItem ? [pendantItem, ...baseItems] : [...baseItems];
            const response = await fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: itemsToAdd })
            });
            if (!response.ok) {
              throw new Error(`Network response was not ok: ${response.status}`);
            }
            }
          }
          localStorage.setItem('openCartDrawerAfterReload', 'true');
          window.location.reload();
        } catch (error) {
          console.error('Error adding to cart:', error);
        }
      }
    });
  } else {
    console.error('Product form not found on page');
  }
function formatMoney(cents, currency, locale = 'en') {
  if (isNaN(cents) || cents === null) {
    return '0';
  }
  const amount = cents / 100;
  let formatted = new Intl.NumberFormat(locale, { 
    style: 'currency', 
    currency: currency,
    minimumFractionDigits: 0,
    maximumFractionDigits: 0
  }).format(amount);
  if (currency === 'INR') {
    formatted = formatted.replace('₹', 'RS, ');
  }
  return formatted.replace(/\./g, ',');
}
  document.addEventListener('DOMContentLoaded', function() {
  if (window.innerWidth >= 1024) {
    const productImages = document.querySelector('.ph-pdp-product-images');
    if (productImages) {
      productImages.style.scrollBehavior = 'smooth';
      productImages.addEventListener('wheel', function(e) {
        const slowScrollFactor = 0.2;
        const slowScrollAmount = e.deltaY * slowScrollFactor;
        productImages.scrollBy({
          top: slowScrollAmount,
          behavior: 'smooth'
        });
      }, { passive: true });
      let touchStartY = 0;
      let touchEndY = 0;
      productImages.addEventListener('touchstart', function(e) {
        touchStartY = e.changedTouches[0].screenY;
      }, { passive: true });
      productImages.addEventListener('touchmove', function(e) {
        touchEndY = e.changedTouches[0].screenY;
        const touchDiff = touchStartY - touchEndY;
        productImages.scrollBy({
          top: touchDiff * 0.2, 
          behavior: 'smooth'
        });
        touchStartY = touchEndY;
      }, { passive: true });
    }
  }
});
});
