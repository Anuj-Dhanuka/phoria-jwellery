            } else {
              addToCartButton.innerText = "Add to Basket";
              addToCartButton.disabled = false;
              if (notifyButton) notifyButton.classList.add('hidden');
            }
          }
        }
        if (chainCache?.loaded) {
          applyChainSourceButtonState();
        } else {
          addToCartButton.innerText = "Add to Basket";
          addToCartButton.disabled = false;
          if (notifyButton) notifyButton.classList.add('hidden');
          if (!window.__phChainSourceCacheListeners) window.__phChainSourceCacheListeners = [];
          window.__phChainSourceCacheListeners.push(applyChainSourceButtonState);
        }
      } else {
        if (selectedVariant.available) {
          dynamicPreOrderText.innerText = "";
          addToCartButton.innerText = "Add to Basket";
          addToCartButton.disabled = false;
          addToCartButton.classList.remove('hidden');
          if (notifyButton) notifyButton.classList.add('hidden');
        } else {
          dynamicPreOrderText.innerText = "";
          addToCartButton.innerText = "Out of Stock";
          addToCartButton.disabled = true;
          addToCartButton.classList.add('hidden');
          if (notifyButton) notifyButton.classList.remove('hidden');
        }
      }        
    }
    updateButtonText();
    if (variantInput) {
      const observer = new MutationObserver(updateButtonText);
      observer.observe(variantInput, {
        attributes: true,
        attributeFilter: ['value']
      });
      variantInput.addEventListener('change', updateButtonText);
    }
    const rerunButtonState = () => {
      requestAnimationFrame(() => {
        setTimeout(updateButtonText, 0);
      });
    };
    const stickyLetterSelectEl = document.getElementById('phStickyLetterCharmSelect');
    stickyLetterSelectEl?.addEventListener('change', rerunButtonState);
    const letterHiddenInput = document.getElementById('LetterCharmSelection');
    letterHiddenInput?.addEventListener('change', rerunButtonState);
    document.querySelectorAll('[data-letter-charms-value], [data-letter-charms-pick]').forEach((el) => {
      el.addEventListener('click', rerunButtonState);
    });
    setTimeout(updateButtonText, 120);
  });
</script>
<script>
  (function () {
    const stickyBar = document.getElementById('phStickyBar');
    if (!stickyBar) return;
    const setStickyHidden = (hidden) => {
      if (hidden) {
        stickyBar.classList.add('is-hidden');
      } else if (typeof window.phPdpToggleStickyVisibility === 'function') {
        window.phPdpToggleStickyVisibility();
      } else {
        stickyBar.classList.remove('is-hidden');
      }
    };
    const isCartOpen = () => {
      const cd = document.querySelector('cart-drawer');
      const nativeOpen = cd && (cd.classList.contains('active') || cd.hasAttribute('open'));
      const bodyLocked =
        document.body.classList.contains('overflow-hidden') || document.body.classList.contains('cart-overflow-hidden');
      const drawerEl = document.getElementById('CartDrawer');
      const drawerActive = drawerEl && drawerEl.classList.contains('active');
      return !!(nativeOpen || bodyLocked || drawerActive);
    };
    setStickyHidden(isCartOpen());
    const cartDrawer = document.querySelector('cart-drawer');
    if (cartDrawer) {
      new MutationObserver((muts) => {
        setStickyHidden(isCartOpen());
      }).observe(cartDrawer, { attributes: true, attributeFilter: ['class', 'open'] });
    }
    const legacyDrawer = document.getElementById('CartDrawer');
    if (legacyDrawer) {
      new MutationObserver(() => setStickyHidden(isCartOpen())).observe(legacyDrawer, {
        attributes: true,
        attributeFilter: ['class'],
      });
    }
    new MutationObserver(() => setStickyHidden(isCartOpen())).observe(document.body, {
      attributes: true,
      attributeFilter: ['class'],
    });
    ['cart:open', 'cart:close', 'cart-drawer:open', 'cart-drawer:close'].forEach((evt) => {
      document.addEventListener(evt, () => setStickyHidden(isCartOpen()), { passive: true });
    });
    if (typeof window.openCartDrawer === 'function') {
      const _open = window.openCartDrawer;
      window.openCartDrawer = function () {
        setStickyHidden(true);
        return _open.apply(this, arguments);
      };
    }
  })();
</script>
