{{ 'section-ph-product-page-mobile-carousel.css' | asset_url | stylesheet_tag }}
{{ 'section-ph-product-page-standard.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-ph-product-page-mobile-carousel.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'section-ph-product-page-media-grouping.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'section-ph-product-page-sticky-fit.js' | asset_url }}" defer="defer"></script>

{{ 'section-ph-product-page-inline.css' | asset_url | stylesheet_tag }}
{% if product.handle == 'anywear-letter-charm-gold' or product.handle == 'anywear-letter-charm-silver' %}
<style>
  .ph-pdp-letter-charms-sub-header {
    margin-bottom: -1.3rem;
  }
</style>
{% endif %}
{{ 'section-ph-product-page-sticky-mobile.css' | asset_url | stylesheet_tag }}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- comment -%} Gift-card flag for sticky bar logic {%- endcomment -%}
{%- assign is_gift_card = false -%}
{%- if product.gift_card or product.handle contains 'gift-card' -%}
  {%- assign is_gift_card = true -%}
{%- endif -%}
{%- assign is_letter_pendant_product = false -%}
{%- if product.handle == 'letter-pendants-silver' or product.handle == 'letter-pendants-gold' -%}
  {%- assign is_letter_pendant_product = true -%}
{%- endif -%}
{%- assign force_sticky_caps_for_letter_pendants = is_letter_pendant_product -%}
{%- assign is_id_waist_chain_product = false -%}
{%- if product.id == 10515901710602 or product.id == 10515902169354 -%}
  {%- assign is_id_waist_chain_product = true -%}
{%- endif -%}
{%- assign is_chain_source_product_liquid = false -%}
{%- if product.id == 10506235674890 or product.id == 10506235838730 or product.id == 10515901710602 or product.id == 10515902169354 -%}
  {%- assign is_chain_source_product_liquid = true -%}
{%- endif -%}
{%- comment -%}
  TEMPORARY HIDE RULES DISABLED:
  Keep this list empty to show all UK sizes.
{%- endcomment -%}
{%- assign hidden_uk_sizes = '' | split: '|' -%}
{%- assign hide_size_style_guide_handles = 'pear-drop-ear-cuff-18ct-gold-vermeil-pear-white-topaz|pear-drop-ear-cuff-925-sterling-silver-pear-white-topaz|sugar-rush-ear-cuff-18ct-gold-vermeil-pear-white-topaz|sugar-rush-ear-cuff-925-sterling-silver-pear-white-topaz' | split: '|' -%}
{%- assign hide_size_style_guide = false -%}
{%- if product.tags contains 'no-size-guide' or hide_size_style_guide_handles contains product.handle -%}
  {%- assign hide_size_style_guide = true -%}
{%- endif -%}
{%- assign lc_enabled_mode = false -%}
{%- if product.tags contains 'lc-enabled' and product.tags contains 'letter-enabled' -%}
  {%- assign lc_enabled_mode = true -%}
{%- endif -%}
{%- assign variant_title_enabled_mode = false -%}
{%- if lc_enabled_mode or product.tags contains 'variant-title-enabled' -%}
  {%- assign variant_title_enabled_mode = true -%}
{%- endif -%}
{%- assign letter_charms_enabled = false -%}
{%- if lc_enabled_mode -%}
  {%- assign letter_charms_enabled = true -%}
{%- endif -%}
{%- assign has_letters_variant_option = false -%}
{%- for option in product.options_with_values -%}
  {%- if option.name == 'Letters' -%}
    {%- assign has_letters_variant_option = true -%}
  {%- endif -%}
{%- endfor -%}
{%- if has_letters_variant_option and is_letter_pendant_product -%}
  {%- assign letter_charms_enabled = false -%}
{%- endif -%}
{%- assign hide_no_letter_for_anywear = false -%}
{%- assign hide_anywear_letter_header_text = false -%}
{%- if product.id == 10492554805514 or product.id == 10492554838282 -%}
  {%- assign hide_anywear_letter_header_text = true -%}
{%- endif -%}
{%- if product.handle == 'anywear-letter-charm-silver' or product.handle == 'anywear-letter-charm-gold' -%}
  {%- assign hide_no_letter_for_anywear = true -%}
{%- endif -%}
{%- assign letter_pendant_handle = '' -%}
{%- if letter_charms_enabled and product.metafields.custom.letter_pendant_product != blank and product.metafields.custom.letter_pendant_product.value != blank -%}
  {%- assign letter_pendant_handle = product.metafields.custom.letter_pendant_product.value.handle -%}
{%- elsif letter_charms_enabled -%}
  {%- if product.handle contains 'gold' -%}
    {%- assign letter_pendant_handle = 'letter-pendant-gold' -%}
  {%- else -%}
    {%- assign letter_pendant_handle = 'letter-pendant-silver' -%}
  {%- endif -%}
{%- endif -%}
{%- assign anywear_base_handle = '' -%}
{%- if product.metafields.custom.anywear_base_product != blank and product.metafields.custom.anywear_base_product.value != blank -%}
  {%- assign anywear_base_handle = product.metafields.custom.anywear_base_product.value.handle -%}
{%- endif -%}
{%- assign anywear_base_variant_id = '' -%}
{%- if product.metafields.custom.anywear_base_variant_id != blank -%}
  {%- assign anywear_base_variant_id = product.metafields.custom.anywear_base_variant_id.value | default: product.metafields.custom.anywear_base_variant_id -%}
{%- endif -%}
<div class="ph-pdp-product-container">
  <div class="ph-pdp-product-layout">
    <div class="ph-pdp-product-details">
      {% if product.metafields.custom.custom_bundle != blank %}
        {% assign ph_product_form_bundle = 'true' %}
      {% else %}
        {% assign ph_product_form_bundle = 'false' %}
      {% endif %}
      {% form 'product', product, enctype: 'multipart/form-data', data-bundle: ph_product_form_bundle %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'title' %}
              <div {{ block.shopify_attributes }}>
                <h1 class="ph-pdp-product-title">
                  {{ product.title }}
                </h1>
                <div class="ph-pdp-product-subtitle"{% unless product.metafields.custom.product_information or product.metafields.custom.extra_info %} style="display:none"{% endunless %}>
                  {{ product.metafields.custom.product_information | default: product.metafields.custom.extra_info }}
                </div>
              </div>
              {% if product.metafields.custom.starting_from_text_for_custom_product != blank %}
            <p class="ph-pdp-starting-from-span-text">{{ product.metafields.custom.starting_from_text_for_custom_product }}</p>
              {% endif %}
            {% when 'price' %}
              <div {{ block.shopify_attributes }}>
                {%- assign ph_display_price = current_variant.price -%}
                {%- if ph_display_price == 0 and letter_charms_enabled -%}
                  {%- if product.handle == 'the-i-d-charm-bracelet-1' -%}
                    {%- assign ph_display_price = 28500 -%}
                  {%- elsif product.handle == 'the-i-d-charm-bracelet' -%}
                    {%- assign ph_display_price = 23500 -%}
                  {%- endif -%}
                {%- endif -%}
                {% if product.tags contains "custom-enquiry-button" %}
                  <div class="ph-pdp-product-price" data-product-price>
                    {% render 'ph-round-money', amount: ph_display_price %}
                  </div>
                {% else %}
                  <div class="ph-pdp-product-price" data-product-price>
                    {% render 'ph-round-money', amount: ph_display_price %}
                  </div>
                                  {% endif %}
              </div>
            {% when 'description' %}
              {% if product.description != blank %}
                <div {{ block.shopify_attributes }}>
                  <div class="ph-pdp-product-description-wrapper">
                    {%- liquid
                      assign description_parts = product.description | split: '<p><!--more--></p>'
                      assign ph_product_description = description_parts[0]
                      assign ph_description_hide_first_mobile = false
                      if template.suffix == 'phoria-default' and ph_product_description contains 'By popular demand'
                        assign ph_description_hide_first_mobile = true
                      endif
                    -%}
                    <div class="ph-pdp-product-description{% if ph_description_hide_first_mobile %} ph-pdp-product-description--hide-first-mobile{% endif %}">
                      {{ ph_product_description }}
                    </div>
                    <span class="ph-pdp-read-more">READ MORE</span>
                  </div>
                </div>
              {% endif %}
          {% endcase %}
        {% endfor %}
        <!-- Wrap remaining elements in a single container for animation -->
        <div class="ph-pdp-product-details--animate">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'plating_option' %}
                {% assign plating_option_index = -1 %}
                {% for option in product.options_with_values %}
                  {% if option.name == 'Plating' or option.name == 'Material' or option.name == 'Metal' %}
                    {% assign plating_option_index = forloop.index0 %}
                    {% assign plating_option = option %}
                  {% endif %}
                {% endfor %}
                {% if plating_option_index >= 0 and plating_option.values.size > 0 %}
                  <div class="ph-pdp-option-group" {{ block.shopify_attributes }}>
                    <div class="ph-pdp-option-header">
                      <div class="ph-pdp-option-title">{{ block.settings.option_label }}</div>
                      <div class="ph-pdp-option-subtitle">{{ block.settings.also_available_text }} </div>
                    </div>
                    <div class="ph-pdp-variant-text-options" data-option-index="{{ plating_option_index }}">
                      {% for value in plating_option.values %}
                        <div
                          class="ph-pdp-text-option {% if plating_option.selected_value == value %}selected{% endif %}"
                          data-option-value="{{ value | escape }}"
                        >
                          {{ value }}
                        </div>
                      {% endfor %}
                      <input
                        type="hidden"
                        name="options[{{ plating_option.name | escape }}]"
                        id="Option{{ plating_option_index }}"
                        value="{{ plating_option.selected_value | default: plating_option.values[0] | escape }}"
                      >
                    </div>
                  </div>
                {% endif %}
              {% when 'color_option' %}
                {% assign color_option_index = -1 %}
                {% for option in product.options_with_values %}
                  {% if option.name == 'Color' or option.name == 'Stone' %}
                    {% assign color_option_index = forloop.index0 %}
                    {% assign color_option = option %}
                  {% endif %}
                {% endfor %}
                {% if color_option_index >= 0 and color_option.values.size > 0 %}
                  <div class="ph-pdp-option-group" {{ block.shopify_attributes }}>
                    <div class="ph-pdp-option-header">
                      <div class="ph-pdp-option-title">{{ block.settings.option_label }}</div>
                      <div class="ph-pdp-option-subtitle">{{ block.settings.also_available_text }}</div>
                    </div>
                    <div class="ph-pdp-variant-boxes" data-option-index="{{ color_option_index }}">
                      {% for value in color_option.values %}
                        {% assign value_handle = value | handle %}
                        <div
                          class="ph-pdp-variant-box color-{{ value_handle }} {% if color_option.selected_value == value %}selected{% endif %}"
                          data-option-value="{{ value | escape }}"
                          title="{{ value }}"
                        ></div>
                      {% endfor %}
                      <input
                        type="hidden"
                        name="options[{{ color_option.name | escape }}]"
                        id="Option{{ color_option_index }}"
                        value="{{ color_option.selected_value | default: color_option.values[0] | escape }}"
                      >
                    </div>
                  </div>
                {% endif %}
                {% unless product.tags contains 'hookup-chain-ring' %}
                  {% if product.metafields.custom.finish.value %}
                    <div class="ph-pdp-option-group">
                      <div class="ph-pdp-option-header">
                        <div class="ph-pdp-option-title">FINISH</div>
                        {% if product.metafields.custom.finish_also_available.value != blank %}
                          <div class="ph-pdp-option-subtitle">ALSO AVAILABLE IN:</div>
                        {% endif %}
                      </div>
                      <div class="ph-pdp-finish-options">
                        <div class="ph-pdp-main-option">
                          <span>{{ product.metafields.custom.finish.value }}</span>
                        </div>
                        {% if product.metafields.custom.finish_also_available.value != blank %}
                          <div class="ph-pdp-mobile-option-subtitle">ALSO AVAILABLE IN:</div>
                          <div class="ph-pdp-alternative-options">
                            {% for finish in product.metafields.custom.finish_also_available.value %}
                              {% assign finish_link = finish.product_link.value.url %}
                              {% assign finish_display = finish.title | split: '- ' | first | strip %}
                              <a href="{{ finish_link }}" data-finish-link>{{ finish_display }}</a>
                            {% endfor %}
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}
                {% endunless %}
                <!-- FINISH OPTION SECTION -->
                {% if product.tags contains 'hookup-chain-ring' %}
                  {% if product.metafields.custom.finish.value %}
                    <div class="ph-pdp-option-group">
                      <div class="ph-pdp-option-header">
                        <div class="ph-pdp-option-title">FINISH</div>
                      </div>
                      {% assign current_finish_label = product.metafields.custom.finish.value.first | default: product.metafields.custom.finish.value | split: '//' | first | strip %}
                      {% assign current_finish_normalized = current_finish_label | downcase %}
                      <div class="custom-ph-pdp-selected-finish">
                        <span class="finish-option">{{ current_finish_label }}</span>
                      </div>
                      {% if product.metafields.custom.finish_also_available.value != blank %}
                        <div class="ph-pdp-finish-available-label">
                          {% if product.tags contains 'custom-order-products' and product.metafields.custom.also_available_text != blank %}
                            {{ product.metafields.custom.also_available_text }}
                          {% else %}
                            ALSO AVAILABLE IN:
                          {% endif %}
                        </div>
                      {% endif %}
                      <div class="custom-ph-pdp-alternative-options">
                        {% for finish in product.metafields.custom.finish_also_available.value %}
                          {% assign finish_parts = finish.title | split: '----' %}
                          {% assign finish_name = finish_parts[0] | split: '/' | first | strip %}
                          {% assign finish_name_normalized = finish_name | downcase %}
                          <!-- take only text before / -->
                          {% assign finish_link = finish.product_link.value.url %}
                          {% unless finish_name_normalized == current_finish_normalized or finish_name == blank %}
                            <div class="finish-col">
                              <a href="{{ finish_link }}" class="finish-option" data-finish-link>
                                {{ finish_name }}
                              </a>
                            </div>
                          {% endunless %}
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}
                {% endif %}
                <!-- STONE OPTION SECTION -->
                {% if product.metafields.custom.stone.value != blank %}
                  <div class="ph-pdp-option-group">
                    <div class="ph-pdp-option-header ph-pdp-option-header_stone">
                      <div class="ph-pdp-option-title">STONE</div>
                      {% if product.metafields.custom.also_available_text_for_stone != blank %}
                        <div class="ph-pdp-option-subtitle">{{product.metafields.custom.also_available_text_for_stone }}</div>
                      {%  endif %}  
                      {% if product.metafields.custom.stone_also_available.value != blank %}
                        <div class="ph-pdp-option-subtitle">ALSO AVAILABLE IN:</div>
                      {% endif %}
                    </div>
                    <div class="ph-pdp-stone-options">
                      <div class="ph-pdp-main-option">
                        {% assign current_stone = product.metafields.custom.stone.value %}
                        {% assign current_stone_normalized = current_stone | downcase %}
                        {% if current_stone_normalized contains 'white topaz' %}
                          <img
                            src="https://cdn.shopify.com/s/files/1/0891/3541/5562/files/White-Topaz-Stone-150x150.webp"
                            class="ph-pdp-stone-image"
                            alt="White Topaz"
                            width="20"
                            height="20"
                          >
                        {% elsif current_stone_normalized contains 'chrome diopside' %}
                          <img
                            src="https://cdn.shopify.com/s/files/1/0891/3541/5562/files/Chrome-Diopside-Stone-2024-150x150.webp"
                            class="ph-pdp-stone-image"
                            alt="Chrome Diopside"
                            width="20"
                            height="20"
                          >
                        {% elsif current_stone_normalized contains 'pink tourmaline' %}
                          <img
                            src="https://cdn.shopify.com/s/files/1/0891/3541/5562/files/Pink-Tourmaline-Stone-2024.png"
                            class="ph-pdp-stone-image"
                            alt="Pink Tourmaline CZ"
                            width="20"
                            height="20"
                          >
                        {% elsif current_stone_normalized contains 'green citrine' %}
                          <img
                            src="https://cdn.shopify.com/s/files/1/0891/3541/5562/files/Green-Citrine-2024-150x150.png"
                            class="ph-pdp-stone-image"
                            alt="Green Citrine CZ"
                            width="20"
                            height="20"
                          >
                        {% endif %}
                        <span>{{ current_stone }}</span>
                      </div>
                      {% if product.metafields.custom.stone_also_available.value != blank %}
                        <div class="ph-pdp-mobile-option-subtitle">ALSO AVAILABLE IN:</div>
                        <div class="ph-pdp-alternative-options">
                          {% for stone in product.metafields.custom.stone_also_available.value %}
                            {% assign stone_url = stone.product.value.url %}
                            {% assign stone_display = stone.title | split: '- ' | first | strip %}
                            <div class="ph-pdp-alternative-options-inside">
                              {% if stone.image.value != blank %}
                                <img
                                  src="{{ stone.image.value | image_url: width: 80 }}"
                                  class="ph-pdp-stone-image"
                                  alt="{{ stone_display }}"
                                  width="20"
                                  height="20"
                                  loading="lazy"
                                >
                              {% endif %}
                              <a href="{{ stone_url }}" style="align-content: center;">
                                {{- stone_display -}}
                              </a>
                            </div>
                          {% endfor %}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              {% when 'size_option' %}
                {% assign size_option_index = -1 %}
                {% for option in product.options_with_values %}
                  {% assign include_as_primary_size_option = false %}
                  {% if option.name == 'Size' or option.name == 'Price' or option.name == 'Denominations' %}
                    {% assign include_as_primary_size_option = true %}
                  {% endif %}
                  {% if is_letter_pendant_product and option.name == 'Letters' %}
                    {% assign include_as_primary_size_option = true %}
                  {% endif %}
                  {% if include_as_primary_size_option %}
                    {% assign size_option_index = forloop.index0 %}
                    {% assign size_option = option %}
                  {% endif %}
                {% endfor %}
                {% assign visible_size_values_count = 0 %}
                {% assign first_visible_size_value = '' %}
                {% assign selected_visible_size_value = '' %}
                {% if size_option_index >= 0 %}
                  {% for value in size_option.values %}
                    {% assign normalized_size_value = value | handle %}
                    {% assign should_hide_size_value = false %}
                    {% if hidden_uk_sizes contains normalized_size_value %}
                      {% assign should_hide_size_value = true %}
                    {% endif %}
                    {% unless should_hide_size_value %}
                      {% assign visible_size_values_count = visible_size_values_count | plus: 1 %}
                      {% if first_visible_size_value == '' %}
                        {% assign first_visible_size_value = value %}
                      {% endif %}
                      {% if size_option.selected_value == value %}
                        {% assign selected_visible_size_value = value %}
                      {% endif %}
                    {% endunless %}
                  {% endfor %}
                {% endif %}
                {% assign effective_selected_size_value = selected_visible_size_value | default: first_visible_size_value %}
                {% if product.tags contains 'drop-3' %}
                  <style>
                    .ph-pdp-option-groupsize {
                      display: none !important;
                    }
                  </style>
                {% endif %}
                {% assign size_placeholder = product.metafields.custom.custom_products_size_placeholder | default: '' %}
{% unless size_placeholder != '' or size_placeholder == nil %}
                {% if size_option_index < 0 and hide_size_style_guide == false %}
                  <div style="padding: 18px 0; display: flex; justify-content: flex-end;">
                    {% if product.collections contains 'crystallised-collection' %}
                      <span id="ph-prsize__chart--trigger__desktop"> Size + Style Guide </span>
                    {% else %}
                      <span id="ph-size__chart--trigger__desktop"> Size + Style Guide </span>
                    {% endif %}
                  </div>
                {% endif %}
                {% endunless %}
                {% if product.metafields.custom.custom_products_size_placeholder != blank %}
                  <div class="ph-pdp-option-groupsize">
                    <div class="ph-pdp-option-header">
                      <div class="ph-pdp-option-title">
                                                {{ product.metafields.custom.custom_products_size_placeholder }}
                      </div>
                      {% if first_option.name != 'Price' and product.handle != 'gift-card' and hide_size_style_guide == false -%}
                        <span id="ph-size__chart--trigger__mobile" class="ph-pdp-option-mobiletitle"
                          >Size + Style Guide</span
                        >
                        <div class="ph-pdp-option-subtitle" style="color:black;">
                          {% if product.collections contains 'crystallised-collection' %}
                            <span id="ph-prsize__chart--trigger__desktop"> Size + Style Guide </span>
                          {% else %}
                            {% unless hide_size_style_guide %}
                              <span id="ph-size__chart--trigger__desktop"> Size + Style Guide</span>
                            {% endunless %}
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                    {% assign ring_size_converter_enabled = false %}
                    {% if size_option.name == 'Size' and size_option.values contains 'UK L/K' %}
                      {% assign ring_size_converter_enabled = true %}
                    {% endif %}
                    {% if ring_size_converter_enabled %}
                      <div class="ph-pdp-size-conversion" data-size-conversion data-size-conversion-mode="uk">
                        <span class="ph-pdp-size-conversion-label" data-size-conversion-label>UK SIZING</span>
                        <button class="ph-pdp-size-conversion-toggle" type="button" data-size-conversion-toggle aria-label="Change sizing system">
                          <svg class="ph-pdp-size-conversion-icon" viewBox="0 0 1280 1280" fill="none" aria-hidden="true" focusable="false">
                            <path d="M245 374H1047" stroke="currentColor" stroke-width="42" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M871 200L1047 374L871 550" stroke="currentColor" stroke-width="42" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M1004 871H200" stroke="currentColor" stroke-width="42" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M375 697L200 871L375 1047" stroke="currentColor" stroke-width="42" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                      </div>
                    {% endif %}
                    <div class="ph-pdp-size-boxes{% if ring_size_converter_enabled %} ph-pdp-ring-size-boxes{% endif %}{% if is_id_waist_chain_product and size_option.name == 'Size' %} ph-pdp-waist-size-boxes{% endif %}" data-option-index="{{ size_option_index }}">
                      {% for value in size_option.values %}
                        {% assign normalized_size_value = value | handle %}
                        {% assign should_hide_size_value = false %}
                        {% if hidden_uk_sizes contains normalized_size_value %}
                          {% assign should_hide_size_value = true %}
                        {% endif %}
                        {% unless should_hide_size_value %}
                          <div
                            class="ph-pdp-size-box {% if effective_selected_size_value == value %}selected{% endif %}"
                            data-option-value="{{ value | escape }}"
                          >
                            {% if is_id_waist_chain_product and size_option.name == 'Size' %}
                              {% assign waist_measurement = '' %}
                              {% assign value_upper = value | upcase %}
                              {% if value_upper contains 'SMALL' %}
                                {% assign waist_measurement = '60 - 80 CM' %}
                              {% elsif value_upper contains 'MEDIUM' %}
                                {% assign waist_measurement = '80 - 100 CM' %}
                              {% endif %}
                              <span class="ph-pdp-chain-size-label">{{ value }}</span>
                              {% if waist_measurement != blank %}
                                <span class="ph-pdp-chain-size-measurement">{{ waist_measurement }}</span>
                              {% endif %}
	                            {% elsif product.handle contains 'gift-card' %}
	                              {{ value | split: '.' | first }}
	                            {% else %}
                                {% assign size_label_us = value %}
                                {% assign size_label_eu = value %}
                                {% case value %}
                                  {% when 'UK E' %}
                                    {% assign size_label_us = 'US 2.5' %}
                                    {% assign size_label_eu = 'EU 44' %}
                                  {% when 'UK F' %}
                                    {% assign size_label_us = 'US 3' %}
                                    {% assign size_label_eu = 'EU 44.5' %}
                                  {% when 'UK G' %}
                                    {% assign size_label_us = 'US 3.5' %}
                                    {% assign size_label_eu = 'EU 45.5' %}
                                  {% when 'UK H' %}
