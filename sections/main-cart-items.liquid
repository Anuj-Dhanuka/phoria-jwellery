<style>
    #{{ section.id }}.ph-cart-accordion {
      margin-top: 36px;
    }

    .ph-cart-accordion__title {
      font-size: 2.266vw;
      line-height: 1.2; 
      margin-bottom: 0px;
    }

    #{{ section.id }} .ph-cart-accordion__item {
        border-top: 1px solid #f1f2ee;
        max-width: 276px;
    }
    #{{ section.id }} .ph-cart-accordion__item:last-child {
        border-bottom: 1px solid #f1f2ee;
    }

    #{{ section.id }} .ph-cart-accordion__item--title {
        position: relative;
    }

    #{{ section.id }} .ph-cart-accordion__item--title h2 {
      font-size: 10px;
      padding: 18px 0;
      text-transform: uppercase;
      font-family: 'PhoriaRegular';
      margin: 0;
      display: inline-block;
      width: 90%;
      line-height: 1.75;
    }

    #{{ section.id }} .ph-cart-accordion__item--title svg {
        width: 10px;
        height: 10px;
        position: absolute;
        top: 50%;
        right: 0;
        transform: translateY(-50%) rotate(-45deg);
        transition: all 0.2s ease-in-out;
    }
    #{{ section.id }} svg.rotate{
        transform: translateY(-50%) rotate(0deg);
    }

    #{{ section.id }} .ph-cart-accordion__item--content {
        font-size: 10px;
        line-height: 2.3;
        font-weight: 400;
        font-family: 'PhoriaRegular';
        text-transform: uppercase;
        max-height: 0;
        padding: 0;
        overflow: hidden;
        transition: all .2s ease-in-out;
    }
  .ph-cart-accordion__item--content a{
    word-wrap: break-word;
  }
    #{{ section.id }} .ph-cart-accordion__item--image {
      width: 100%;
      height: 100%;
      max-width: 276px;
    }
    #{{ section.id }} .ph-cart-accordion__item--image img{
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    #{{ section.id }} .ph-cart-accordion__item--content p strong{
       font-family: 'PhoriaBold';
       font-weight: 400 !important;
    }
    #{{ section.id }} .ph-cart-accordion__item--content.expended{
        /* height: auto; */
        max-height: 1500px;
    }
    .ph-cart__inner{
       display: flex;
        flex-direction: column;
      flex: 1;
      padding-left: 36px;
      
    }
  .ph-cart__item--details{
    justify-content: center;
  }
  .ph-cart-item__bottom{
    justify-content: flex-end;
    column-gap: 5vw;
    max-width: 367px;
  }
@media screen and (max-width: 1120px){
  .ph-cart-item__bottom{
    column-gap: 7vw;
  }
}
  /* -- complementary gift box checkbox styles  */

.ph-cart-custom-checkbox {
  display: flex;
  align-items: center;
  cursor: pointer;
  font-size: 10px;
  gap: 8px;
  user-select: none;
  width: 44.2rem;
  max-width: 100%;
  margin-bottom: 18px;
}
.ph-cart-custom-title{
  font-size: 10px;
  font-family: 'PhoriaBold';
  font-weight: 400 !important;
  line-height: 2.3;
  width: 44.2rem;
  max-width: 100%;
}

.ph-cart-custom-checkbox input[type="checkbox"].sr-only {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.ph-cart-custom-checkbox .checkmark {
  width: 18px;
  height: 18px;
  border: 1px solid #000;
  display: inline-block;
  position: relative;
  transition: all 0.2s;
  flex-shrink: 0;
}

.ph-cart-custom-checkbox input:checked + .checkmark::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 39%;
  width: 5px;
  height: 10px;
  border: solid black;
  border-width: 0 1.5px 1.5px 0;
  transform: translate(-50%, -50%) rotate(45deg);
}
  .totals__shipping.subtitle{
    font-size: 10px;
    line-height: 2.3;

  }
  .totals__shipping-value{
    font-size: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .totals__shipping-value strong{
    font-family: 'PhoriaBold';
    font-weight: 400 !important;
  }
  .totals__shipping-value span{
    width: 20px;
    height: 20px;
    border: 1px solid #1D1D1D;
    display: inline-block;
    position: relative;
  }
  .totals__shipping-value span::before{
    content: '';
    width: 12px;
    height: 12px;
    background: #1D1D1D;
    position: absolute;
    top: 50.5%;
    left: 50.5%;
    transform: translate(-50%, -50%);
  }

  .ph-cart__checkoutbtn{
    margin-top: 20px;
  }
  .ph-cart__checkoutbtn .cart__checkout-button{
    text-transform: uppercase;
    font-size: 12px;
    line-height: 2.3;
    padding: 13px 18px;
    font-weight: normal !important;
  }
  .ph-empty-cart__text{
    text-align: center;
    font-size: 10px;
    font-family: 'PhoriaRegular';
    margin: 0;
    margin-top: 18px;
  }
  .ph-empty-cart__text strong{
    font-family: 'PhoriaBold';
    font-weight: 400 !important;
  }
  {% if cart.item_count == 0 %}
  .main-cart__wrapper{
    justify-content: center;
  }
  @media screen and (min-width: 989px){
    .section-cart-items{
      height: 347px;
    }
  }
  {% endif %}
@media screen and (max-width: 989px){
  .ph-cart-custom-checkbox, .ph-cart-custom-title{
    margin-left: 0;
  }
}

  /* -----------------------------------------  */
