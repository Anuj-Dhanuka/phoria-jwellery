<div class="main-cart section-{{ section.id }}">
  <div class="container">
    {% comment %}<div class="page-header">
      <div class="page-header__inner">
        <h1 class="main-page-title page-title title--page h3">{{ 'sections.cart.title' | t }}</h1>
        <a href="{{ routes.all_products_collection_url }}" class="button button--simple button--arrow focus-inset">
          <span>{{ 'general.continue_shopping' | t }}</span>
        </a>
      </div>
    </div>{% endcomment %}

    <h1 class="ph-cart-accordion__title" {% if cart.item_count == 0 %}style="text-align: center;"{% endif %}>Basket</h1>
    <div class="main-cart__wrapper ph-main__cart">
      {% if cart.item_count == 0 %} <p class="ph-empty-cart__text">Your Basket is empty. <a href="/collections/shop-all"><strong>Continue shopping</strong></a></p> {% else %}
      <div id="{{ section.id }}" class="ph-cart-accordion">
        {% if section.settings.acc_title1 != blank %}
        <div class="ph-cart-accordion__item">
            <div class="ph-cart-accordion__item--title">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
                <h2>{{ section.settings.acc_title1 }}</h2>
            </div>
            <div class="ph-cart-accordion__item--content">{{ section.settings.acc_content1 }}</div>
          </div>
        {% endif %}
        {% if section.settings.acc_title2 != blank %}
        <div class="ph-cart-accordion__item">
            <div class="ph-cart-accordion__item--title">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
                <h2>{{ section.settings.acc_title2 }}</h2>
            </div>
            <div class="ph-cart-accordion__item--content">{{ section.settings.acc_content2 }}</div>
          </div>
        {% endif %}
        {% if section.settings.acc_title3 != blank %}
        <div class="ph-cart-accordion__item">
            <div class="ph-cart-accordion__item--title">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
                <h2>{{ section.settings.acc_title3 }}</h2>
            </div>
            <div class="ph-cart-accordion__item--content">
              {{ section.settings.acc_content3 }}
              {% if section.settings.acc_image3 != blank %}
                <a href="{{ section.settings.acc_image3_link }}"><div class="ph-cart-accordion__item--image">
                  <img src="{{ section.settings.acc_image3 | image_url }}" width="" height="" alt="{{ section.settings.acc_title3  }}">
                </div></a>
              {% endif %}
            </div>
          </div>
        {% endif %}
        {% if section.settings.acc_title4 != blank %}
        <div class="ph-cart-accordion__item">
            <div class="ph-cart-accordion__item--title">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
                <h2>{{ section.settings.acc_title4 }}</h2>
            </div>
            <div class="ph-cart-accordion__item--content">{{ section.settings.acc_content4 }}</div>
        </div>
        {% endif %}
        {% if section.settings.acc_title5 != blank %}
        <div class="ph-cart-accordion__item">
            <div class="ph-cart-accordion__item--title">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
                <h2>{{ section.settings.acc_title5 }}</h2>
            </div>
            <div class="ph-cart-accordion__item--content">{{ section.settings.acc_content5 }}</div>
          </div>
        {% endif %}
      </div>
      <div class="ph-cart__inner">
      <cart-items class="{% if cart == empty %} is-empty{% endif %}">
        <div id="main-cart-shipping" data-id="{{ section.id }}">
					{% comment %}<p class="main-cart--title h3">{{ 'sections.cart.title' | t }}</p>{% endcomment %}
          <div class="js-contents-shipping">
            {% if settings.show_shipping %}
              <div class="cart-shipping" data-min-spend="{{ settings.min_spend | times: 100.0 }}" data-total="{{ cart.total_price }}"
                data-message = " {{ settings.message_shipping }}">
                <span class="cart-shipping__progress">
                  <span class="cart-shipping__progress-current"></span>
                </span>
                <p class="cart-shipping__message cart-shipping__message_default active secondary_text"></p>
                <p class="cart-shipping__message cart-shipping__message_success secondary_text">
                  {{ settings.message_shipping_free }}
                </p>
              </div>
            {% endif %}
          </div>
        </div>
        <div class="cart__warnings">
          <div class="cart__empty-wrapper">
            <p class="cart__empty-text h3">{{ 'sections.cart.empty' | t }}</p>
          </div>
          <a href="{{ routes.collections_url | sort_by: 'best-selling' }}" class="button button--tertiary focus-inset secondary_text">
           <span>  {{ 'general.cart.button_label' | t }} </span>
          </a>
        </div>

        <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
          <div id="main-cart-items" data-id="{{ section.id }}">
            <div class="js-contents">
              {%- if cart != empty -%}
                <div class="cart-items">
                      {% assign show_lc_components = false %}
                      {% if request.query_string contains 'show_lc=1' %}
                        {% assign show_lc_components = true %}
                      {% endif %}
											{%- for item in cart.items -%}
                      {% if item.properties._lc_hidden_component == 'true' and show_lc_components == false %}
                        {% continue %}
                      {% endif %}
                      {% assign ph_bundle_key = item.properties._ph_bundle_key %}
                      {% assign ph_bundle_title = item.properties._ph_bundle_title %}
                      {% assign lc_display_title = item.properties._lc_display_title | default: '' %}
                      {% assign ph_bundle_is_component = false %}
                      {% assign ph_bundle_is_first = true %}
                      {% if ph_bundle_key != blank %}
                        {% assign ph_bundle_is_component = true %}
                        {% assign ph_bundle_is_first = false %}
                        {% for bundle_check_item in cart.items %}
                          {% if bundle_check_item.properties._ph_bundle_key == ph_bundle_key %}
                            {% if bundle_check_item.key == item.key %}
                              {% assign ph_bundle_is_first = true %}
                            {% endif %}
                            {% break %}
                          {% endif %}
                        {% endfor %}
                      {% endif %}
                      {% if ph_bundle_is_component and ph_bundle_is_first == false and show_lc_components == false %}
                        {% continue %}
                      {% endif %}
                      {% assign variant_base_price = item.variant.price | default: item.original_price %}
                      {% assign compare_at_price = item.variant.compare_at_price | default: 0 %}
                      {% assign effective_original_price = variant_base_price %}
                      {% if item.original_price > effective_original_price %}
                        {% assign effective_original_price = item.original_price %}
                      {% endif %}
                      {% if compare_at_price > effective_original_price %}
                        {% assign effective_original_price = compare_at_price %}
                      {% endif %}
                      {% assign variant_base_line_price = variant_base_price | times: item.quantity %}
                      {% assign compare_at_line_price = compare_at_price | times: item.quantity %}
                      {% assign effective_original_line_price = variant_base_line_price %}
                      {% if item.original_line_price > effective_original_line_price %}
                        {% assign effective_original_line_price = item.original_line_price %}
                      {% endif %}
                      {% if compare_at_line_price > effective_original_line_price %}
                        {% assign effective_original_line_price = compare_at_line_price %}
                      {% endif %}
                      {% assign hide_lc_letter_component = false %}
                      {% assign item_letter_charm_value = item.properties._letter_charm | default: item.properties['Letter Charms'] %}
                      {% if item.properties._linked_parent_product != blank and item.properties._selected_letter != blank %}
                        {% assign has_matching_lc_parent = false %}
                        {% assign lc_bundle_key = item.properties._lc_bundle_key | default: '' %}
                        {% for parent_item in cart.items %}
                          {% if parent_item.key != item.key %}
                            {% assign parent_matches_bundle = false %}
                            {% if ph_bundle_key != blank and parent_item.properties._ph_bundle_key == ph_bundle_key %}
                              {% assign parent_matches_bundle = true %}
                            {% endif %}
                            {% assign parent_matches_lc_bundle = false %}
                            {% if lc_bundle_key != blank and parent_item.properties._lc_bundle_key == lc_bundle_key %}
                              {% assign parent_matches_lc_bundle = true %}
                            {% endif %}
                            {% assign parent_matches_link = false %}
                            {% assign parent_letter_charm_value = parent_item.properties._letter_charm | default: parent_item.properties['Letter Charms'] %}
                            {% if parent_letter_charm_value != blank and parent_letter_charm_value == item.properties._selected_letter %}
                              {% assign parent_matches_link = true %}
                            {% endif %}
                            {% if parent_matches_bundle or parent_matches_lc_bundle or parent_matches_link %}
                              {% assign has_matching_lc_parent = true %}
                              {% break %}
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                        {% if has_matching_lc_parent %}
                          {% assign hide_lc_letter_component = true %}
                        {% endif %}
                      {% endif %}
                      {% if hide_lc_letter_component and show_lc_components == false %}
                        {% continue %}
                      {% endif %}
                      {% assign bundle_addon_original_price = 0 %}
                      {% assign bundle_addon_final_price = 0 %}
                      {% assign bundle_addon_original_line_price = 0 %}
                      {% assign bundle_addon_final_line_price = 0 %}
                      {% assign hidden_base_original_price = 0 %}
                      {% assign hidden_base_final_price = 0 %}
                      {% assign hidden_base_original_line_price = 0 %}
                      {% assign hidden_base_final_line_price = 0 %}
                      {% assign parent_lc_bundle_key = item.properties._lc_bundle_key | default: '' %}
                      {% if item.properties._lc_parent_bundle == 'true' and parent_lc_bundle_key != blank %}
                        {% for bundle_item in cart.items %}
                          {% if bundle_item.properties._lc_hidden_component == 'true' and bundle_item.properties._lc_bundle_key == parent_lc_bundle_key %}
                            {% assign hidden_base_original_price = hidden_base_original_price | plus: bundle_item.original_price %}
                            {% assign hidden_base_final_price = hidden_base_final_price | plus: bundle_item.final_price %}
                            {% assign hidden_base_original_line_price = hidden_base_original_line_price | plus: bundle_item.original_line_price %}
                            {% assign hidden_base_final_line_price = hidden_base_final_line_price | plus: bundle_item.final_line_price %}
                          {% endif %}
                        {% endfor %}
                      {% endif %}
                      {% assign item_is_lc_parent = false %}
                      {% if item.product.tags contains 'lc-enabled' or item.properties._lc_parent_bundle == 'true' or item.properties._letter_charm_selection != blank %}
                        {% assign item_is_lc_parent = true %}
                      {% endif %}
                      {% if item_is_lc_parent and item_letter_charm_value != blank and item_letter_charm_value != 'NO LETTER' %}
                        {% for bundle_item in cart.items %}
                          {% assign same_bundle_key = false %}
                          {% if ph_bundle_key != blank and bundle_item.properties._ph_bundle_key == ph_bundle_key %}
                            {% assign same_bundle_key = true %}
                          {% endif %}
                          {% assign same_lc_bundle_key = false %}
                          {% if parent_lc_bundle_key != blank and bundle_item.properties._lc_bundle_key == parent_lc_bundle_key %}
                            {% assign same_lc_bundle_key = true %}
                          {% endif %}
                          {% assign same_linked_parent = false %}
                          {% if bundle_item.properties._linked_parent_product != blank and bundle_item.properties._linked_parent_product == item.product.title %}
                            {% assign same_linked_parent = true %}
                          {% endif %}
                          {% assign same_letter_selection = false %}
                          {% if bundle_item.properties._selected_letter != blank and bundle_item.properties._selected_letter == item_letter_charm_value %}
                            {% assign same_letter_selection = true %}
                          {% endif %}
                          {% assign should_merge_lc_addon = false %}
                          {% if bundle_item.properties._linked_parent_product != blank and bundle_item.properties._selected_letter != blank %}
                            {% if same_bundle_key %}
                              {% assign should_merge_lc_addon = true %}
                            {% elsif same_lc_bundle_key %}
                              {% assign should_merge_lc_addon = true %}
                            {% elsif same_linked_parent and same_letter_selection %}
                              {% assign should_merge_lc_addon = true %}
                            {% endif %}
                          {% endif %}
                          {% if should_merge_lc_addon %}
                            {% assign bundle_addon_original_price = bundle_addon_original_price | plus: bundle_item.original_price %}
                            {% assign bundle_addon_final_price = bundle_addon_final_price | plus: bundle_item.final_price %}
                            {% assign bundle_addon_original_line_price = bundle_addon_original_line_price | plus: bundle_item.original_line_price %}
                            {% assign bundle_addon_final_line_price = bundle_addon_final_line_price | plus: bundle_item.final_line_price %}
                          {% endif %}
                        {% endfor %}
                      {% endif %}
                      {% assign display_original_price = item.original_price | plus: bundle_addon_original_price | plus: hidden_base_original_price %}
                      {% assign display_final_price = item.final_price | plus: bundle_addon_final_price | plus: hidden_base_final_price %}
                      {% assign display_original_line_price = item.original_line_price | plus: bundle_addon_original_line_price | plus: hidden_base_original_line_price %}
                      {% assign display_final_line_price = item.final_line_price | plus: bundle_addon_final_line_price | plus: hidden_base_final_line_price %}
                      {% assign display_effective_original_price = effective_original_price | plus: bundle_addon_original_price | plus: hidden_base_original_price %}
                      {% assign display_effective_original_line_price = effective_original_line_price | plus: bundle_addon_original_line_price | plus: hidden_base_original_line_price %}
                      {% assign cart_display_image = item.image %}
                      {% if item.variant.featured_image == blank and item.product.featured_media.preview_image != blank %}
                        {% assign cart_display_image = item.product.featured_media.preview_image %}
                      {% endif %}
                      {% assign image_source_item = item %}
                      {% assign image_source_from_linked_component = false %}
                      {% assign current_item_letter_value = item.properties._letter_charm | default: item.properties['Letter Charms'] | default: item.properties['Letter Charm'] | default: item.properties._letter_charm_selection | strip %}
                      {% if current_item_letter_value == blank %}
                        {% assign current_item_letter_value = item.properties._selected_letter | strip %}
                      {% endif %}
                      {% assign current_item_letter_value = current_item_letter_value | upcase %}
                      {% assign cart_grouped_media_enabled = false %}
                      {% if item.product.tags contains 'vimgord' or item.product.tags contains 'ph-chain-grouped-media' %}
                        {% assign cart_grouped_media_enabled = true %}
                      {% endif %}
                      {% assign current_item_has_grouped_media = false %}
                      {% if cart_grouped_media_enabled and item.product.media.size > 0 %}
                        {% for media in item.product.media %}
