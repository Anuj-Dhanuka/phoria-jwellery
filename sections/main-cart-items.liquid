     }
    {% endif %}
     #{{ section.id }}.ph-cart-accordion {
      width: 25%;
    }
  }
  
    @media screen and (max-width: 989px){
      .section-cart-items{
        padding-top: 36px !important;
      }
      .ph-cart__inner{
        padding-left: 0;
      }
      #{{ section.id }}.ph-cart-accordion {
        order: 2;
