      }
    }
  @media screen and (max-width: 649px){
    .ph-cart-item__bottom{
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      column-gap: 18px;
      row-gap: 18px;
      max-width: 367px;
    }
    .cart-item cart-remove-button a{
      padding: 0;
      margin-top: 9px;
    }
    .container{
      padding-left: 18px; 
      padding-right: 18px; 
    }
  }



  .price-compare-price-main-cart {
    text-decoration: line-through;
    font-family: var(--font-body-family);
    font-size: 10px;
  }

  .totals {
    align-items: baseline;
    justify-content: space-between;
    width: 100%;
  }

  .compare-price-sub-total-container {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 10px;
  }

  .compare-price-sub-total {
    text-decoration: line-through;
    opacity: 0.6;
    font-size: 12px;
    line-height: 1;
    margin: 0;
  }
</style>

