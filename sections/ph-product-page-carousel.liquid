{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}

<style>
  .ph-carousel-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_desktop_top }}px;
    padding-bottom: {{ section.settings.padding_desktop_bottom }}px;
    background: #fff;
  }

  .ph-carousel-heading-{{ section.id }} {
    text-align: center;
    font-family: 'PhoriaBold';
    font-size: 19px;
    text-transform: uppercase;
    letter-spacing: -0.48px;
    line-height: 31.2px;
    margin: 0 0 34px;
    opacity: 1;
  }

  .ph-carousel-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 44px {{ section.settings.space_between }}px;
    width: 100%;
    padding: 0;
  }

  .ph-carousel-grid-{{ section.id }} .ph-carousel-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: left;
    opacity: 1;
  }

  .ph-carousel-grid-{{ section.id }} .ph-car__link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-decoration: none;
    color: inherit;
    width: 100%;
  }

  .ph-carousel-grid-{{ section.id }} .ph-car__media {
    width: 100%;
    max-width: 350px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    position: relative;
    margin: 0 auto;
  }

  .ph-carousel-grid-{{ section.id }} .ph-car__media-swiper,
  .ph-carousel-grid-{{ section.id }} .ph-car__media-swiper .swiper-wrapper,
  .ph-carousel-grid-{{ section.id }} .ph-car__media-swiper .swiper-slide {
    width: 100%;
    height: 100%;
  }

  .ph-carousel-grid-{{ section.id }} .ph-car__media-swiper .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ph-carousel-grid-{{ section.id }} .ph-car__media img,
  .ph-carousel-grid-{{ section.id }} .ph-car__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease-in-out;
  }

  .ph-carousel-grid-{{ section.id }} .ph-car__slide--video {
    background: #fff;
  }

  .ph-carousel-grid-{{ section.id }} .ph-car__video {
    display: block;
  }

  .ph-carousel-grid-{{ section.id }} .ph-carousel-card:hover .ph-car__media img,
  .ph-carousel-grid-{{ section.id }} .ph-carousel-card:hover .ph-car__media video {
    transform: scale(1.05);
  }

  .ph-carousel-grid-{{ section.id }} .ph-car__title {
    font-family: 'PhoriaBold';
    font-size: 10px;
    letter-spacing: 0;
    line-height: 1.3;
    text-transform: uppercase;
    margin: 14px 0 0 0;
    text-decoration: none !important;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    min-height: calc(1.3em * 2);
    max-width: 100%;
  }

  .ph-carousel-grid-{{ section.id }} .ph-car__finish {
    font-family: 'PhoriaTight', 'PhoriaRegular', sans-serif;
    color: #737373;
    font-size: clamp(5.75px, 1vw, 6.75px);
    letter-spacing: 0;
    line-height: 1.2;
    text-transform: uppercase;
    margin: 5px 0 0 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: clip;
    max-width: 100%;
  }

  .ph-carousel-grid-{{ section.id }} .ph-car__price {
    font-family: 'PhoriaBold';
    font-size: 10px;
    color: #050505;
    letter-spacing: 0;
    line-height: 1;
    margin: 11px 0 0 0;
    white-space: nowrap;
  }

  .ph-carousel-grid-{{ section.id }} .ph-car__media-progress {
    content: "";
    display: block;
    width: 100%;
    height: 1.5px;
    margin: 0 0 12px;
    order: 2;
    background: transparent;
    overflow: hidden;
  }

  .ph-carousel-grid-{{ section.id }} .ph-car__media-progress span {
    display: block;
    width: 35px;
    height: 100%;
    background: #111;
    transform: translateX(0);
    transition: transform 0.35s ease;
  }

  .ph-carousel-grid-{{ section.id }} .ph-car__media {
    order: 1;
  }

  .ph-carousel-grid-{{ section.id }} .ph-car__media-progress,
  .ph-carousel-grid-{{ section.id }} .ph-car__title,
  .ph-carousel-grid-{{ section.id }} .ph-car__finish,
  .ph-carousel-grid-{{ section.id }} .ph-car__price {
    order: 3;
  }

  .ph-car__price-inner {
    display: inline-flex;
    flex-direction: row;
    align-items: baseline;
    gap: 6px;
  }

  .ph-car__compare-price {
    text-decoration: line-through;
    color: #888;
    font-size: 0.9em;
  }

  .ph-car__from-label {
    font-family: 'PhoriaRegular';
    text-transform: uppercase;
  }

  @media (max-width: 989px) {
    .ph-carousel-section-{{ section.id }} {
      margin-top: -30px;
      padding-top: 3.55rem;
      padding-bottom: 2.95rem;
      padding-left: 20px;
      padding-right: 20px;
    }

    .ph-carousel-heading-{{ section.id }} {
      font-size: 19px;
      letter-spacing: -0.48px;
      line-height: 31.2px;
      margin-bottom: 3.2rem;
    }

    .ph-carousel-grid-{{ section.id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 20px;
      row-gap: 50px;
    }

    .ph-carousel-grid-{{ section.id }} .ph-carousel-card:nth-child(n+5) {
      display: none;
    }

    .ph-carousel-grid-{{ section.id }} .ph-car__media {
      max-width: none;
    }

    .ph-carousel-grid-{{ section.id }} .ph-car__title,
    .ph-carousel-grid-{{ section.id }} .ph-car__price {
      letter-spacing: 0;
    }

    .ph-carousel-grid-{{ section.id }} .ph-car__title {
      font-size: 10px;
      line-height: 1.3;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      white-space: normal;
      overflow: hidden;
      text-overflow: ellipsis;
      min-height: calc(1.3em * 2);
      max-width: 100%;
    }

    .ph-carousel-grid-{{ section.id }} .ph-car__price {
      font-size: 10px;
      line-height: 1;
    }

    .ph-carousel-grid-{{ section.id }} .ph-car__finish {
      color: #737373;
      font-size: clamp(5.75px, 1vw, 6.75px);
      letter-spacing: 0;
      line-height: 1.2;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: clip;
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .ph-carousel-grid-{{ section.id }} {
      column-gap: 16px;
      row-gap: 46px;
    }
  }

  @media (max-width: 989px) {
    [class*="ph-carousel-grid"] {
      padding: 0 9px;
      column-gap: 4px;
      row-gap: 70px;
    }

    [class*="ph-carousel-grid"] .ph-carousel-card .ph-car__media-progress {
      margin-bottom: 0;
    }

    [class*="ph-carousel-grid"] .ph-carousel-card .ph-car__title {
      margin-top: 17px;
      font-size: 9px;
      line-height: 16px;
      min-height: 0;
      height: auto;
    }

    [class*="ph-carousel-grid"] .ph-carousel-card .ph-car__finish {
      font-size: 8px;
      line-height: 16px;
      margin-top: 1.2px;
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
    }

    [class*="ph-carousel-grid"] .ph-carousel-card .ph-car__finish .ph-car__stone {
      display: inline-block;
      white-space: nowrap;
    }

    [class*="ph-carousel-grid"] .ph-carousel-card .ph-car__price {
      margin-top: 11.5px;
      font-size: 10px;
      line-height: 10px;
    }
  }
</style>

<section class="ph-carousel-section-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="ph-carousel-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
  {% endif %}

  {%- assign dynamic_layer_up_products = nil -%}
  {%- if product != blank and product.metafields.custom.layer_up_products.value != blank -%}
    {%- assign dynamic_layer_up_products = product.metafields.custom.layer_up_products.value -%}
  {%- endif -%}

  {% if dynamic_layer_up_products != nil and dynamic_layer_up_products.size > 0 %}
    <div class="ph-carousel-grid-{{ section.id }}">
      {% for p in dynamic_layer_up_products %}
        <div class="ph-carousel-card">
          <a href="{{ p.url }}" class="ph-car__link">
            <div class="ph-car__media">
              <div class="swiper ph-car__media-swiper" data-ph-card-media-swiper>
                <div class="swiper-wrapper">
                  {%- assign rendered_media_count = 0 -%}
                  {% for media in p.media limit: 5 %}
                    {% if media.media_type == 'video' %}
                      {%- assign rendered_media_count = rendered_media_count | plus: 1 -%}
                      <div class="swiper-slide ph-car__slide--video">
                        {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'ph-car__video' }}
                      </div>
                    {% else %}
                      {%- assign preview_src = media.preview_image | image_url: width: 700 -%}
                      {% if preview_src != blank %}
                        {%- assign rendered_media_count = rendered_media_count | plus: 1 -%}
                        <div class="swiper-slide">
                          <img
                            src="{{ preview_src }}"
                            alt="{{ media.alt | default: p.title }}"
                            loading="lazy"
                            width="350"
                            height="350"
                            data-ph-fallback="1"
                          >
                        </div>
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                  {% if rendered_media_count == 0 and p.featured_image != blank %}
                    <div class="swiper-slide">
                      <img
                        src="{{ p.featured_image | image_url: width: 700 }}"
                        alt="{{ p.title }}"
                        loading="lazy"
                        width="350"
                        height="350"
                        onerror="var s=this.closest('.swiper-slide'); if(s) s.remove();"
                      >
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>

            <div class="ph-car__media-progress" aria-hidden="true"><span></span></div>

            <h3 class="ph-car__title">{{ p.title }}</h3>

            {%- assign car_subtitle = p.metafields.custom.layer_up_subtitle | default: p.metafields.custom.product_information | default: p.metafields.custom.extra_info -%}
            {%- unless car_subtitle != blank -%}
              {%- assign car_subtitle = p.metafields.custom.finish.value -%}
            {%- endunless -%}
            {% if car_subtitle != blank %}
              {%- assign car_subtitle_parts = car_subtitle | split: '//' -%}
              <p class="ph-car__finish">{%- if car_subtitle_parts.size > 1 -%}{{ car_subtitle_parts[0] | strip }} <span class="ph-car__stone">// {{ car_subtitle_parts[1] | strip }}</span>{%- else -%}{{ car_subtitle }}{%- endif -%}</p>
            {% endif %}

            <div class="ph-car__price">
              <div class="ph-car__price-inner">
                {% if p.compare_at_price > p.price %}
                  <span class="ph-car__compare-price">{% render 'ph-round-money', amount: p.compare_at_price %}</span>
                {% endif %}
                <strong>{% render 'ph-round-money', amount: p.price %}</strong>
              </div>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  {% elsif section.blocks.size > 0 %}
    <div class="ph-carousel-grid-{{ section.id }}">
      {% for block in section.blocks %}
        {%- assign product_link = '#' -%}
        {%- if block.settings.product_item != blank -%}
          {%- assign product_link = block.settings.product_item.url -%}

          {%- if block.settings.custom_product_url != blank -%}
            {%- assign product_link = block.settings.custom_product_url -%}
          {%- elsif block.settings.custom_variant_id != blank -%}
            {%- assign product_link = product_link | append: '?variant=' | append: block.settings.custom_variant_id -%}
          {%- else -%}
            {%- assign card_title_for_match = block.settings.override_title | default: block.settings.product_item.title | upcase -%}
            {%- assign derived_letter = '' -%}

            {%- if card_title_for_match contains 'THE ' -%}
              {%- assign title_after_the = card_title_for_match | split: 'THE ' | last -%}
              {%- assign derived_letter = title_after_the | remove: '"' | remove: '"' | remove: '"' | remove: "'" | strip | slice: 0, 1 -%}
            {%- endif -%}

            {%- if derived_letter != blank -%}
              {%- assign matched_variant_id = '' -%}
              {%- for variant in block.settings.product_item.variants -%}
                {%- assign option_1 = variant.option1 | upcase | strip -%}
                {%- assign option_2 = variant.option2 | upcase | strip -%}
                {%- assign option_3 = variant.option3 | upcase | strip -%}
                {%- if option_1 == derived_letter or option_2 == derived_letter or option_3 == derived_letter -%}
                  {%- assign matched_variant_id = variant.id -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if matched_variant_id != blank -%}
                {%- assign product_link = product_link | append: '?variant=' | append: matched_variant_id -%}
              {%- else -%}
                {%- assign product_link = product_link | append: '?ph_letter=' | append: derived_letter -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}

        <div class="ph-carousel-card" {{ block.shopify_attributes }}>
          <a href="{{ product_link }}" class="ph-car__link">
            <div class="ph-car__media">
              <div class="swiper ph-car__media-swiper" data-ph-card-media-swiper>
                <div class="swiper-wrapper">
                  {%- assign rendered_media_count = 0 -%}
                  {%- assign first_media = block.settings.product_item.media | first -%}

                  {% if block.settings.show_custom_thumbnail and block.settings.product_thumbnail_image != blank and block.settings.is_video_product_thumbnail == false %}
                    {%- assign rendered_media_count = rendered_media_count | plus: 1 -%}
                    <div class="swiper-slide">
                      <img
                        src="{{ block.settings.product_thumbnail_image | image_url: width: 700 }}"
                        alt="{{ block.settings.override_title | default: block.settings.product_item.title }}"
                        loading="lazy"
                        width="350"
                        height="350"
                        {% if block.settings.scale_media %}style="transform: scale({{ block.settings.scale_value }});"{% endif %}
                      >
                    </div>
                  {% elsif block.settings.show_custom_thumbnail and block.settings.product_thumbnail_video != blank and block.settings.is_video_product_thumbnail %}
                    {%- assign rendered_media_count = rendered_media_count | plus: 1 -%}
                    <div class="swiper-slide">
                      {% if block.settings.scale_media %}
                        <style>.ph-car-vid-{{ block.id }}{transform: scale({{ block.settings.scale_value }});}</style>
                      {% endif %}
                      {{ block.settings.product_thumbnail_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, preload: 'none', class: 'ph-car-vid-' | append: block.id }}
                    </div>
                  {% endif %}

                  {% for media in block.settings.product_item.media limit: 5 %}
                    {% if rendered_media_count < 5 %}
                      {% if media.media_type == 'image' %}
                        {%- assign rendered_media_count = rendered_media_count | plus: 1 -%}
                        <div class="swiper-slide">
                          <img
                            src="{{ media | image_url: width: 700 }}"
                            alt="{{ media.alt | default: block.settings.product_item.title }}"
                            loading="lazy"
                            width="350"
                            height="350"
                            {% if block.settings.scale_media %}style="transform: scale({{ block.settings.scale_value }});"{% endif %}
                          >
                        </div>
                      {% elsif media.media_type == 'video' %}
                        {%- assign rendered_media_count = rendered_media_count | plus: 1 -%}
                        <div class="swiper-slide">
                          {% if block.settings.scale_media %}
                            <style>.ph-car-vid-{{ block.id }}-{{ forloop.index }}{transform: scale({{ block.settings.scale_value }});}</style>
                          {% endif %}
                          {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, preload: 'none', class: 'ph-car-vid-' | append: block.id | append: '-' | append: forloop.index }}
                        </div>
                      {% endif %}
                    {% endif %}
                  {% endfor %}

                  {% if rendered_media_count == 0 and first_media.media_type == 'image' %}
                    <div class="swiper-slide">
                      <img
                        src="{{ first_media | image_url: width: 700 }}"
                        alt="{{ block.settings.product_item.title }}"
                        loading="lazy"
                        width="350"
                        height="350"
                        {% if block.settings.scale_media %}style="transform: scale({{ block.settings.scale_value }});"{% endif %}
                      >
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>

            <div class="ph-car__media-progress" aria-hidden="true"><span></span></div>

            <h3 class="ph-car__title">
              {{ block.settings.override_title | default: block.settings.product_item.title }}
            </h3>

            {%- assign block_car_subtitle = '' -%}
            {%- if block.settings.show_custom_finish -%}
              {%- assign block_car_subtitle = block.settings.custom_finish_text -%}
            {%- elsif block.settings.product_item.metafields.custom.layer_up_subtitle != blank -%}
              {%- assign block_car_subtitle = block.settings.product_item.metafields.custom.layer_up_subtitle -%}
            {%- elsif block.settings.product_item.metafields.custom.finish != blank -%}
              {%- assign block_car_subtitle = block.settings.product_item.metafields.custom.finish.value -%}
            {%- endif -%}
            {% if block_car_subtitle != blank %}
              {%- assign block_car_subtitle_parts = block_car_subtitle | split: '//' -%}
              <p class="ph-car__finish">{%- if block_car_subtitle_parts.size > 1 -%}{{ block_car_subtitle_parts[0] | strip }} <span class="ph-car__stone">// {{ block_car_subtitle_parts[1] | strip }}</span>{%- else -%}{{ block_car_subtitle }}{%- endif -%}</p>
            {% endif %}

            <div class="ph-car__price">
                {%- assign resolved_price = block.settings.product_item.price -%}
                {%- assign resolved_price_override = false -%}
                {%- assign linked_letter = '' -%}
                {%- if block.settings.custom_product_url != blank and block.settings.custom_product_url contains 'ph_letter=' -%}
                  {%- assign linked_letter = block.settings.custom_product_url | split: 'ph_letter=' | last | split: '&' | first | replace: '%20', ' ' | downcase -%}
                {%- elsif product_link contains 'ph_letter=' -%}
                  {%- assign linked_letter = product_link | split: 'ph_letter=' | last | split: '&' | first | replace: '%20', ' ' | downcase -%}
                {%- endif -%}

                {%- if linked_letter == blank -%}
                  {%- assign card_title_for_price_match = block.settings.override_title | default: block.settings.product_item.title | upcase -%}
                  {%- if card_title_for_price_match contains 'THE ' -%}
                    {%- assign title_after_the = card_title_for_price_match | split: 'THE ' | last -%}
                    {%- assign derived_title_letter = title_after_the | remove: '"' | remove: '"' | remove: '"' | remove: "'" | strip | slice: 0, 1 | downcase -%}
                    {%- if derived_title_letter >= 'a' and derived_title_letter <= 'z' -%}
                      {%- assign linked_letter = derived_title_letter -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}

                {%- assign is_id_charm_gold_card = false -%}
                {%- assign is_id_charm_silver_card = false -%}
                {%- if block.settings.product_item.id == 10506235674890 or block.settings.product_item.handle == 'screw-chain-bracelet-18ct-gold-vermeil' or block.settings.custom_product_url contains '/products/the-i-d-charm-bracelet-1' -%}
                  {%- assign is_id_charm_gold_card = true -%}
                {%- elsif block.settings.product_item.id == 10506235838730 or block.settings.product_item.handle == 'screw-chain-bracelet-925-sterling-silver' or block.settings.custom_product_url contains '/products/the-i-d-charm-bracelet' -%}
                  {%- assign is_id_charm_silver_card = true -%}
                {%- endif -%}

                {%- if is_id_charm_gold_card -%}
                  {%- assign resolved_price = 28500 -%}
                  {%- if linked_letter != blank and linked_letter != 'no letter' -%}
                    {%- assign _car_lp_gold = all_products['letter-pendant-gold'] -%}
                    {%- assign _car_addon_gold = _car_lp_gold.price_min | default: 11000 -%}
                    {%- assign resolved_price = resolved_price | plus: _car_addon_gold -%}
                  {%- endif -%}
                  {%- assign resolved_price_override = true -%}
                {%- elsif is_id_charm_silver_card -%}
                  {%- assign resolved_price = 23500 -%}
                  {%- if linked_letter != blank and linked_letter != 'no letter' -%}
                    {%- assign _car_lp_silver = all_products['letter-pendant-silver'] -%}
                    {%- assign _car_addon_silver = _car_lp_silver.price_min | default: 8500 -%}
                    {%- assign resolved_price = resolved_price | plus: _car_addon_silver -%}
                  {%- endif -%}
                  {%- assign resolved_price_override = true -%}
                {%- endif -%}

                {% if block.settings.show_from_prefix %}
                  <span class="ph-car__from-label">FROM </span>
                {% endif %}
                {% if block.settings.custom_price_text != blank %}
                  {% assign custom_price_clean = block.settings.custom_price_text | strip | remove: ',' %}
                  {% assign custom_price_cents = custom_price_clean | times: 100 %}
                  {% if custom_price_cents > 0 %}
                    <strong>{% render 'ph-round-money', amount: custom_price_cents %}</strong>
                  {% else %}
                    <strong>{{ block.settings.custom_price_text }}</strong>
                  {% endif %}
                {% elsif resolved_price_override %}
                  <div class="ph-car__price-inner">
                    <strong>{% render 'ph-round-money', amount: resolved_price %}</strong>
                  </div>
                {% else %}
                  <div class="ph-car__price-inner">
                    {% if block.settings.product_item.compare_at_price > block.settings.product_item.price %}
                      <span class="ph-car__compare-price">{% render 'ph-round-money', amount: block.settings.product_item.compare_at_price %}</span>
                    {% endif %}
                    <strong>{% render 'ph-round-money', amount: block.settings.product_item.price %}</strong>
                  </div>
                {% endif %}
              </div>
          </a>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p style="text-align: center; font-family: 'PhoriaRegular';">Add products using the block panel on the left.</p>
  {% endif %}
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var sectionId = '{{ section.id }}';
    var enableAnimations = {{ section.settings.enable_animations | json }};

    // Heading animation
    if (enableAnimations && typeof Motion !== 'undefined') {
      var heading = document.querySelector('.ph-carousel-heading-' + sectionId);
      if (heading) {
        Motion.inView(heading, function (elem) {
          Motion.animate(elem, { opacity: [0, 1], y: ['40px', '0px'] }, { duration: 0.6, easing: 'ease-out' });
        }, { once: true });
      }
    } else {
      var heading = document.querySelector('.ph-carousel-heading-' + sectionId);
      if (heading) heading.style.opacity = '1';
    }

    var carouselEl = document.querySelector('.ph-carousel-grid-' + sectionId);
    if (!carouselEl) return;

    var mediaSwipersInited = false;
    var observer = new IntersectionObserver(function (entries) {
      if (!entries[0].isIntersecting || mediaSwipersInited) return;
      mediaSwipersInited = true;
      observer.disconnect();

      var cards = carouselEl.querySelectorAll('.ph-carousel-card');
      if (!enableAnimations || typeof Motion === 'undefined') {
        cards.forEach(function (card) { card.style.opacity = '1'; });
      } else {
        cards.forEach(function (card, i) {
          Motion.animate(card, { opacity: [0, 1], y: ['40px', '0px'] }, { duration: 0.5, delay: i * 0.08, easing: 'ease-out' });
        });
      }

      if (typeof Swiper === 'undefined') return;

      cards.forEach(function (card) {
        var mediaSwiperEl = card.querySelector('[data-ph-card-media-swiper]');
        if (!mediaSwiperEl) return;

        var wrapper = mediaSwiperEl.querySelector('.swiper-wrapper');
        if (wrapper) {
          wrapper.querySelectorAll('img').forEach(function (img) {
            if (img.complete && img.naturalWidth === 0) {
              var slide = img.closest('.swiper-slide');
              if (slide) slide.remove();
            }
          });
        }

        var slides = mediaSwiperEl.querySelectorAll('.swiper-slide');
        var progress = card.querySelector('.ph-car__media-progress span');

        var setProgress = function (swiper) {
          if (!progress || swiper.slides.length <= 1) {
            if (progress) progress.style.transform = 'translateX(0)';
            return;
          }

          var maxIndex = Math.max(swiper.slides.length - 1, 1);
          var percent = Math.min(Math.max(swiper.realIndex / maxIndex, 0), 1);
          var maxOffset = Math.max(progress.parentElement.clientWidth - progress.offsetWidth, 0);
          progress.style.transform = 'translateX(' + (maxOffset * percent) + 'px)';
        };

        if (slides.length <= 1) return;

        var cardSwiper = new Swiper(mediaSwiperEl, {
          slidesPerView: 1,
          spaceBetween: 0,
          loop: false,
          watchOverflow: true,
          resistanceRatio: 0.65,
          speed: 450,
          threshold: 4,
          nested: true,
          preventClicks: true,
          preventClicksPropagation: true,
          touchStartPreventDefault: false,
          on: {
            init: setProgress,
            slideChange: setProgress,
            setTranslate: setProgress
          }
        });

        if (wrapper) {
          wrapper.querySelectorAll('img').forEach(function (img) {
            img.addEventListener('error', function () {
              var slide = img.closest('.swiper-slide');
              if (slide) slide.remove();
              cardSwiper.update();
              setProgress(cardSwiper);
            });
          });
        }

        setProgress(cardSwiper);
      });
    }, { rootMargin: '200px' });
    observer.observe(carouselEl);
  });
</script>

