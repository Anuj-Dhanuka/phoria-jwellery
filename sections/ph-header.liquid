          <svg viewBox="0 0 6 10.5" width="6" height="10.5" aria-hidden="true" focusable="false"><path d="M5.5 .3 .8 5.25 5.5 10.2"/></svg>
        </button>
        {%- assign ann_index = 0 -%}
        {%- for text in (1..3) -%}
          {%- liquid
            if forloop.index == 1
              assign ann_text = section.settings.announcement_text
            elsif forloop.index == 2
