{%- liquid
  assign hero_image = section.settings.hero_image
  assign hero_alt = section.settings.hero_alt | default: collection.title
  assign hero_slide_count = 0
  if section.settings.hero_image != blank
    assign hero_slide_count = hero_slide_count | plus: 1
  endif
  if section.settings.hero_image_2 != blank
    assign hero_slide_count = hero_slide_count | plus: 1
  endif
  if section.settings.hero_image_3 != blank
    assign hero_slide_count = hero_slide_count | plus: 1
  endif
  if section.settings.hero_image_4 != blank
    assign hero_slide_count = hero_slide_count | plus: 1
  endif
  if section.settings.hero_image_5 != blank
    assign hero_slide_count = hero_slide_count | plus: 1
  endif
-%}

{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>

<style>
