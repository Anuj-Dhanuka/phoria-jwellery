    <script>
      var _phShopCurrency = '{{ shop.currency }}';

      (function() {
        function phFormatPresentmentCents(presentmentCents, currency) {
          var roundedSmallest = Math.round(presentmentCents / 100) * 100;
          var amount = roundedSmallest / 100;
          try {
            var formatted = new Intl.NumberFormat('en', {
              style: 'currency',
              currency: currency,
              minimumFractionDigits: 0,
              maximumFractionDigits: 0
            }).format(amount);
            if (currency.toUpperCase() === 'INR') {
              formatted = formatted.replace('₹', 'RS, ');
            }
            return formatted.replace(/\./g, ',');
          } catch (e) {
            return amount.toLocaleString();
          }
        }

        window.phFormatManualPrice = function(baseCents, rate, currency) {
          var convertedSmallest = Math.round(baseCents * rate);
          return phFormatPresentmentCents(convertedSmallest, currency || 'INR');
        };

        function phUpdateNodes(el, text) {
          el.querySelectorAll('.price-item--regular, .price-item, .ph-search-product-price, .ph-search-product-compare-price').forEach(function(node) {
            node.textContent = text;
          });
        }

        window.phVariantJsonCache = window.phVariantJsonCache || {};
        window.phFetchVariantJson = window.phFetchVariantJson || function(variantId) {
          var id = String(variantId || '').trim();
          if (!id) return Promise.resolve(null);
          if (!window.phVariantJsonCache[id]) {
            window.phVariantJsonCache[id] = fetch('/variants/' + id + '.js').then(function(response) {
              if (!response.ok) return null;
              return response.json();
            }).catch(function() {
              return null;
            });
          }
          return window.phVariantJsonCache[id];
        };

        function convertManualPriceCards() {
          var shopCurrency = window._phShopCurrency;
          var currency = window.Shopify && window.Shopify.currency && window.Shopify.currency.active;
          var rate = parseFloat((window.Shopify && window.Shopify.currency && window.Shopify.currency.rate) || '1');
          if (!currency || !isFinite(rate) || rate <= 0) return;
          if (currency.toUpperCase() === (shopCurrency || '').toUpperCase()) return;

          document.querySelectorAll('[data-ph-manual-base-cents]:not([data-ph-converted])').forEach(function(el) {
            var baseCents = parseInt(el.getAttribute('data-ph-manual-base-cents') || '0', 10);
            if (!baseCents) return;
            el.setAttribute('data-ph-converted', '1');

            var variantId = el.getAttribute('data-ph-variant-id');
            if (variantId) {
              window.phFetchVariantJson(variantId)
                .then(function(data) {
                  var presentmentCents = data && data.price;
                  var text = (presentmentCents && presentmentCents > 0)
                    ? phFormatPresentmentCents(presentmentCents, currency)
                    : window.phFormatManualPrice(baseCents, rate, currency);
                  phUpdateNodes(el, text);
                })
                .catch(function() {
                  phUpdateNodes(el, window.phFormatManualPrice(baseCents, rate, currency));
                });
            } else {
              phUpdateNodes(el, window.phFormatManualPrice(baseCents, rate, currency));
            }
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', convertManualPriceCards);
        } else {
          convertManualPriceCards();
        }
        setTimeout(convertManualPriceCards, 800);
      })();
    </script>
