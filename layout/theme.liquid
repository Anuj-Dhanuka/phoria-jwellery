    <script>
      document.addEventListener('DOMContentLoaded', function () {
        try {
          if (['127.0.0.1', 'localhost'].includes(window.location.hostname)) return;
          if (window.location.pathname === '/localization') return;
          var detectedCountry = (window.Shopify && window.Shopify.country ? String(window.Shopify.country) : '').toUpperCase();
          if (!/^[A-Z]{2}$/.test(detectedCountry)) return;

          var storageKey = 'ph_market_country_applied_v1';
          if (window.sessionStorage && sessionStorage.getItem(storageKey) === detectedCountry) return;

          var form = document.createElement('form');
          form.method = 'POST';
          form.action = '/localization';
          form.style.display = 'none';

          var safePath = window.location.pathname === '/localization' ? '/' : window.location.pathname;
          var fields = {
            form_type: 'localization',
            utf8: '✓',
            _method: 'put',
            country_code: detectedCountry,
            return_to: safePath + window.location.search + window.location.hash
          };

          Object.keys(fields).forEach(function (name) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            input.value = fields[name];
            form.appendChild(input);
          });

          document.body.appendChild(form);
          if (window.sessionStorage) sessionStorage.setItem(storageKey, detectedCountry);
          form.submit();
        } catch (error) {
          // no-op: fallback is default Shopify market/currency
        }
      });
    </script>
