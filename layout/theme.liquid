        var sels = 'shop-pay-button, shop-pay-wallet-button, shopify-accelerated-checkout, shopify-accelerated-checkout-cart, [data-shopify-buttoncontainer], [data-shopify="payment-button"], .shopify-payment-button, .shopify-payment-button__button, .shopify-payment-button__button--branded, .shopify-payment-button__button--unbranded, .shopify-payment-button__button--branded-shop-pay, [data-testid="shop-pay-button"], .shop-pay-button-container, .product-form__checkout, .ph-pdp-wallet-buttons';
        function nuke() {
          document.querySelectorAll(sels).forEach(function (el) {
            el.style.display = 'none';
            el.setAttribute('aria-hidden', 'true');
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', nuke);
        } else {
          nuke();
        }
        window.addEventListener('load', nuke);
        new MutationObserver(nuke).observe(document.documentElement, { childList: true, subtree: true });
      })();
    </script>
