    <script>
      document.addEventListener('DOMContentLoaded', function () {
        if (!window.IntersectionObserver) return;
        var seen = new WeakSet();
        document.querySelectorAll('video[autoplay]').forEach(function (v) {
          if (seen.has(v)) return;
          var rect = v.getBoundingClientRect();
          if (rect.top < window.innerHeight + 300) return;
          seen.add(v);
          var srcs = Array.from(v.querySelectorAll('source')).map(function (s) {
            return { el: s, src: s.src };
          }).filter(function (x) { return x.src; });
          if (!srcs.length) return;
          srcs.forEach(function (x) { x.el.removeAttribute('src'); });
          new IntersectionObserver(function (entries, obs) {
            if (!entries[0].isIntersecting) return;
            obs.disconnect();
            srcs.forEach(function (x) { x.el.src = x.src; });
            v.load();
            v.play().catch(function () {});
          }, { rootMargin: '200px' }).observe(v);
        });
      });
    </script>
