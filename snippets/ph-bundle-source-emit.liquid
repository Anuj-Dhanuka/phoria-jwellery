  {%- when 10498030633226 -%}{%- assign _bh = 'screw-chain-bracelet-925-sterling-silver' -%}
  {%- when 10498031583498 -%}{%- assign _bh = 'screw-chain-bracelet-18ct-gold-vermeil' -%}
