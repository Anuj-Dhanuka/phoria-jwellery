<div class="ph-pdp-standard" aria-label="The Phoria Standard">
  <h2 class="ph-pdp-standard__title">The Phoria Standard</h2>
  <div class="ph-pdp-standard__items">
    <div class="ph-pdp-standard__item">
      <img
        class="ph-pdp-standard__icon"
        src="{{ 'ph-standard-marquise.png' | asset_url }}"
        alt=""
        loading="lazy"
        width="58"
        height="58"
      >
      <p class="ph-pdp-standard__text">
        <span>Lifetime warranty</span>
        <span>on every piece</span>
      </p>
    </div>
    <div class="ph-pdp-standard__item">
      <img
        class="ph-pdp-standard__icon"
        src="{{ 'ph-standard-emerald.png' | asset_url }}"
        alt=""
        loading="lazy"
        width="58"
        height="58"
      >
      <p class="ph-pdp-standard__text">
        <span>Complimentary gift wrapping</span>
        <span>+ jewellery storage box</span>
      </p>
    </div>
    <div class="ph-pdp-standard__item">
      <img
        class="ph-pdp-standard__icon"
        src="{{ 'ph-standard-round.png' | asset_url }}"
        alt=""
        loading="lazy"
        width="58"
        height="58"
      >
      <p class="ph-pdp-standard__text">
        <span>Free UK delivery</span>
        <span>with every order</span>
      </p>
    </div>
    <div class="ph-pdp-standard__item">
      <img
        class="ph-pdp-standard__icon"
        src="{{ 'ph-standard-pear.png' | asset_url }}"
        alt=""
        loading="lazy"
        width="58"
        height="58"
      >
      <p class="ph-pdp-standard__text">
        <span>Fast worldwide shipping</span>
        <span>in up to 3 days</span>
      </p>
    </div>
  </div>
</div>
