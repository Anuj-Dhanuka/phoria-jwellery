{% comment %}
  Renders cart drawer

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

<style>
  .drawer {
    visibility: hidden;
  }
.promo-code-text {
  color: #000;             /* vivid red */
  font-size: 10px;            /* adjust up/down as needed */
  text-align: start;
  margin-top: 18px !important;
  text-transform: uppercase;  /* match existing style */
  font-family: "PhoriaRegular";
}

  .drawer__inner{
    width: 600px;
  }
  .drawer__close{
    text-transform: uppercase;
    font-family: "PhoriaBold";
    font-size: 10px;
    width: auto;
    height: auto;
    line-height: 17px;
  }
  .drawer .cart-item__bottom{
    display: none;
  }
  .cart__empty-text{
    text-transform: uppercase;
    font-size: 18px;
    margin-top: 20px;
    margin-bottom: 15px;
  }

  .ph-cart__drawer--heading{
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 72px 0 9px;
    margin-left: 24px;
    margin-right: 18px;
  }
    
  .ph-cart__drawer--heading h2{
    font-size: 1.25vw;
    margin-top: 14px;
  }
  
  .cart-item__inner-top{
    padding-top: 15px;
    padding-bottom: 18px;
  }
  .cart__empty-divider{
    height: 1px;
     margin-bottom: 8px;
    border-bottom: 1px solid #f1f2ee !important;
  }
.ph-cart__note--wrapper{
  display: flex;
  padding: 9px 0px 18px 0px;
  flex-direction: column;
  gap: 10px;
}
  cart-gift-note-checkbox label{
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 18px;
    cursor: pointer;
  }
  .cart-gift-note-checkbox{
    font-size: 10px;
    font-family: 'PhoriaRegular';
  }
  .ph-cart__note--title{
    font-family: "PhoriaBold";
    font-size: 10px;
    text-transform: uppercase;
  }
  .ph-cart__note--wrapper .cart__note.field textarea{
    text-transform: uppercase;
    font-family: "PhoriaRegular";
    font-size: 10px;
    resize: none;
    border: 1px solid #f1f2ee;
  }
  .ph-cart__note--wrapper .cart__note.field textarea::placeholder {
    font-size: 10px !important;
  }

  .cart-item__info{
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }
  cart-remove-button button.button--simple{
    padding: 0;
    font-weight: 400;
  }
  cart-remove-button button.button--simple > span{
    text-transform: uppercase;
    font-family: "PhoriaRegular";
    font-size: 10px;
    margin-top: 5px;
  }
  h3.totals__subtotal.subtitle{
    text-transform: uppercase !important;
    font-size: 10px;
    font-family: "PhoriaRegular";
    font-weight: normal;
  }
  .totals__subtotal-value.secondary_text{
    font-size: 14px;
    font-family: "PhoriaBold";
    color: #1D1D1D;
  }
  .drawer__footer{
    padding-bottom: 27px;
    padding-top: 9px;
  }
  .cart-item__inner-top{
    border-bottom: 1px solid #f1f2ee !important;
  }
  .cart__ctas a > span{
    font-size: 10px;
  }
  .cart__ctas a > span:before, .cart__ctas a > span:after{
    display: none;
  }
  .cart-drawer .cart__link{
    padding: 0;
    margin-top: 27px;
  }
@media screen and (max-width: 989px){
  .drawer__inner{
    width: 90vw;
  }
  .ph-cart__drawer--heading h2{
    font-size: 18px;
  }
}

@media screen and (max-width: 569px){
  .drawer__inner{
    width: 100vw;
  }
}
   {%- if cart == empty -%}
     .top{
       width: 100%;
       text-align: center;
     }

    .cart__empty-text-desc{
      font-size: 10px;
       margin-top: 13px;
    }
     
     .cart-shipping, .drawer__heading{
       display: none;
     }
    {% endif %}

    .compare-price {
      text-transform: uppercase;
    font-family: var(--font-body-family);

    }

    .drawer-custom-coupon-code {
      color: #000;
      font-family: "PhoriaRegular";
      margin: 20px 0;
      text-align: right;
    }

    .totals {
      align-items: baseline;
      justify-content: space-between;
      width: 100%;
    }

    .compare-price-sub-total-container {
      display: flex;
      align-items: baseline;
      justify-content: flex-end;
      gap: 10px;
    }

    .compare-price-sub-total {
      text-decoration: line-through;
      opacity: 0.6;
      font-size: 12px;
      line-height: 1;
      margin: 0;
    }

    .gap-small {
      gap: 10px;
    }

    .mb-0 {
      margin-bottom: 0;
    }
</style>

{% comment %}
  assign min_total = settings.min_spend | plus: 0.0
  assign progress = total | divided_by: min_total | times: 100
  if progress > 100
    assign progress = 100
  endif
{% endcomment %}



<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer {% if settings.notification %} notification {% endif %}">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'general.cart.item_added' | t }}"
      tabindex="-1"
    >
      <div class="drawer__header">
        {% comment %}<h2 class="drawer__heading h3">{{ 'general.cart.item_added' | t }} ({{ cart.item_count }})</h2>{% endcomment %}
        {% if settings.notification %}
          <h2 class="drawer__notification_heading h3">{{ 'general.cart.item_added_notification' | t }}</h2>
        {% endif %}
        <button
          type="button"
          class="drawer__close focus-inset modal-close-button focus-inset"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% comment %}{% render 'icon-close' %}{% endcomment %} CLOSE
        </button>

        {% if settings.show_shipping %}
          <div class="cart-shipping" data-min-spend="{{ settings.min_spend | times: 100.0 }}" data-total="{{ cart.total_price }}"
            data-message = " {{ settings.message_shipping }}">
            <span class="cart-shipping__progress">
              <span class="cart-shipping__progress-current"></span>
            </span>
            <p class="cart-shipping__message secondary_text cart-shipping__message_default active"></p>
            <p class="cart-shipping__message secondary_text cart-shipping__message_success">
              {{ settings.message_shipping_free }}
            </p>
          </div>
        {% endif %}
      </div>
      <div class="ph-cart__drawer--heading">
        <h2 class="drawer__heading h3">{{ 'general.cart.item_added' | t }}</h2>
      </div>
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="top">
            <div class="cart__empty-wrapper">

              <p class="cart__empty-text h3">Basket</p>
        
              <div class="cart__empty-divider"></div>
              <p class="cart__empty-text-desc">NO PRODUCTS IN THE BASKET.</p>
            </div>
          </div>
        </div>
        {% comment %}
        <div class="drawer__inner-empty">
          <div class="top">
            <div class="cart__empty-wrapper">
              <p class="cart__empty-text h3">{{ 'general.cart.empty_cart' | t }}</p>
              <p class="cart__empty-dec secondary_text"> {{ settings.empty_cart_dec }} </p>
            </div>
            <a
              href="{{ routes.all_products_collection_url }}"
              class="button button--{{ settings.cart_button_style }} focus-inset"
            >
              <span> {{ 'general.cart.button_label' | t }} </span>
            </a>
          </div>
          {% if settings.empty_cart_promo %}
            <div class="cart-block">
              <div class="cart-image-block">
                {% if settings.empty_cart_image != blank %}
                  {{
                    settings.empty_cart_image
                    | image_url:
                      width: settings.empty_cart_image.width
                    | image_tag:
                      loading: 'lazy',
                      sizes: '100vw',
                      widths: '360, 550, 710',
                      width: settings.empty_cart_image.width,
                      class: 'cart-block-image'
                  }}
                {%  else %}
                  {{ "hero-apparel-1" | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
               </div>
              
              {% if settings.empty_cart_heading != blank %}
                <div class="cart-block-heading subtitle">
                  {{ settings.empty_cart_heading }}
                </div>
              {%- endif -%}
              {% if settings.empty_cart_button_link != blank %}
                <a
                  href="{{ settings.empty_cart_button_link }}"
                  class="cart-block-button link link--overlay"
                >
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
        {% endcomment %}
      {%- endif -%}
      <cart-drawer-items
        {% if cart == empty %}
          class=" is-empty"
        {% endif %}
      >
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <div class="drawer__cart-items-wrapper">
                {% assign show_lc_components = false %}
                {% if request.query_string contains 'show_lc=1' %}
                  {% assign show_lc_components = true %}
                {% endif %}
                {%- for item in cart.items -%}
                  {% if item.properties._lc_hidden_component == 'true' and show_lc_components == false %}
                    {% continue %}
                  {% endif %}
                  {% assign ph_bundle_key = item.properties._ph_bundle_key %}
                  {% assign ph_bundle_title = item.properties._ph_bundle_title %}
                  {% assign lc_display_title = item.properties._lc_display_title | default: '' %}
                  {% assign ph_bundle_is_component = false %}
                  {% assign ph_bundle_is_first = true %}
                  {% if ph_bundle_key != blank %}
                    {% assign ph_bundle_is_component = true %}
                    {% assign ph_bundle_is_first = false %}
                    {% for bundle_check_item in cart.items %}
                      {% if bundle_check_item.properties._ph_bundle_key == ph_bundle_key %}
                        {% if bundle_check_item.key == item.key %}
                          {% assign ph_bundle_is_first = true %}
                        {% endif %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                  {% assign variant_base_price = item.variant.price | default: item.original_price %}
                  {% assign compare_at_price = item.variant.compare_at_price | default: 0 %}
                  {% assign effective_original_price = variant_base_price %}
                  {% if item.original_price > effective_original_price %}
                    {% assign effective_original_price = item.original_price %}
                  {% endif %}
                  {% if compare_at_price > effective_original_price %}
                    {% assign effective_original_price = compare_at_price %}
                  {% endif %}
                  {% assign variant_base_line_price = variant_base_price | times: item.quantity %}
                  {% assign compare_at_line_price = compare_at_price | times: item.quantity %}
                  {% assign effective_original_line_price = variant_base_line_price %}
                  {% if item.original_line_price > effective_original_line_price %}
                    {% assign effective_original_line_price = item.original_line_price %}
                  {% endif %}
                  {% if compare_at_line_price > effective_original_line_price %}
                    {% assign effective_original_line_price = compare_at_line_price %}
                  {% endif %}
                  {% assign hide_lc_letter_component = false %}
                  {% assign item_letter_charm_value = item.properties._letter_charm | default: item.properties['Letter Charms'] %}
                  {% if item.properties._linked_parent_product != blank and item.properties._selected_letter != blank %}
                    {% assign has_matching_lc_parent = false %}
                    {% assign lc_bundle_key = item.properties._lc_bundle_key | default: '' %}
                    {% for parent_item in cart.items %}
                      {% if parent_item.key != item.key %}
                        {% assign parent_matches_bundle = false %}
                        {% if ph_bundle_key != blank and parent_item.properties._ph_bundle_key == ph_bundle_key %}
                          {% assign parent_matches_bundle = true %}
                        {% endif %}
                        {% assign parent_matches_lc_bundle = false %}
                        {% if lc_bundle_key != blank and parent_item.properties._lc_bundle_key == lc_bundle_key %}
                          {% assign parent_matches_lc_bundle = true %}
                        {% endif %}
                        {% assign parent_matches_link = false %}
                        {% assign parent_letter_charm_value = parent_item.properties._letter_charm | default: parent_item.properties['Letter Charms'] %}
                        {% if parent_letter_charm_value != blank and parent_letter_charm_value == item.properties._selected_letter %}
                          {% assign parent_matches_link = true %}
                        {% endif %}
                        {% if parent_matches_bundle or parent_matches_lc_bundle or parent_matches_link %}
                          {% assign has_matching_lc_parent = true %}
                          {% break %}
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                    {% if has_matching_lc_parent %}
                      {% assign hide_lc_letter_component = true %}
                    {% endif %}
                  {% endif %}
                  {% if hide_lc_letter_component and show_lc_components == false %}
                    {% continue %}
                  {% endif %}
                  {% assign bundle_addon_original_price = 0 %}
                  {% assign bundle_addon_final_price = 0 %}
                  {% assign bundle_addon_original_line_price = 0 %}
                  {% assign bundle_addon_final_line_price = 0 %}
                  {% assign hidden_base_original_price = 0 %}
                  {% assign hidden_base_final_price = 0 %}
                  {% assign hidden_base_original_line_price = 0 %}
                  {% assign hidden_base_final_line_price = 0 %}
                  {% assign parent_lc_bundle_key = item.properties._lc_bundle_key | default: '' %}
                  {% if item.properties._lc_parent_bundle == 'true' and parent_lc_bundle_key != blank %}
                    {% for bundle_item in cart.items %}
                      {% if bundle_item.properties._lc_hidden_component == 'true' and bundle_item.properties._lc_bundle_key == parent_lc_bundle_key %}
                        {% assign hidden_base_original_price = hidden_base_original_price | plus: bundle_item.original_price %}
                        {% assign hidden_base_final_price = hidden_base_final_price | plus: bundle_item.final_price %}
                        {% assign hidden_base_original_line_price = hidden_base_original_line_price | plus: bundle_item.original_line_price %}
                        {% assign hidden_base_final_line_price = hidden_base_final_line_price | plus: bundle_item.final_line_price %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                  {% assign item_is_lc_parent = false %}
                  {% if item.product.tags contains 'lc-enabled' or item.properties._lc_parent_bundle == 'true' or item.properties._letter_charm_selection != blank %}
                    {% assign item_is_lc_parent = true %}
                  {% endif %}
                  {% if item_is_lc_parent and item_letter_charm_value != blank and item_letter_charm_value != 'NO LETTER' %}
                    {% for bundle_item in cart.items %}
                      {% assign same_bundle_key = false %}
                      {% if ph_bundle_key != blank and bundle_item.properties._ph_bundle_key == ph_bundle_key %}
                        {% assign same_bundle_key = true %}
                      {% endif %}
                      {% assign same_lc_bundle_key = false %}
                      {% if parent_lc_bundle_key != blank and bundle_item.properties._lc_bundle_key == parent_lc_bundle_key %}
                        {% assign same_lc_bundle_key = true %}
                      {% endif %}
                      {% assign same_linked_parent = false %}
                      {% if bundle_item.properties._linked_parent_product != blank and bundle_item.properties._linked_parent_product == item.product.title %}
                        {% assign same_linked_parent = true %}
                      {% endif %}
                      {% assign same_letter_selection = false %}
                      {% if bundle_item.properties._selected_letter != blank and bundle_item.properties._selected_letter == item_letter_charm_value %}
                        {% assign same_letter_selection = true %}
                      {% endif %}
                      {% assign should_merge_lc_addon = false %}
                      {% if bundle_item.properties._linked_parent_product != blank and bundle_item.properties._selected_letter != blank %}
                        {% if same_bundle_key %}
                          {% assign should_merge_lc_addon = true %}
                        {% elsif same_lc_bundle_key %}
                          {% assign should_merge_lc_addon = true %}
                        {% elsif same_linked_parent and same_letter_selection %}
                          {% assign should_merge_lc_addon = true %}
                        {% endif %}
                      {% endif %}
                      {% if should_merge_lc_addon %}
                        {% assign bundle_addon_original_price = bundle_addon_original_price | plus: bundle_item.original_price %}
                        {% assign bundle_addon_final_price = bundle_addon_final_price | plus: bundle_item.final_price %}
                        {% assign bundle_addon_original_line_price = bundle_addon_original_line_price | plus: bundle_item.original_line_price %}
                        {% assign bundle_addon_final_line_price = bundle_addon_final_line_price | plus: bundle_item.final_line_price %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                  {% assign display_original_price = item.original_price | plus: bundle_addon_original_price | plus: hidden_base_original_price %}
                  {% assign display_final_price = item.final_price | plus: bundle_addon_final_price | plus: hidden_base_final_price %}
                  {% assign display_original_line_price = item.original_line_price | plus: bundle_addon_original_line_price | plus: hidden_base_original_line_price %}
                  {% assign display_final_line_price = item.final_line_price | plus: bundle_addon_final_line_price | plus: hidden_base_final_line_price %}
                  {% assign display_effective_original_price = effective_original_price | plus: bundle_addon_original_price | plus: hidden_base_original_price %}
                  {% assign display_effective_original_line_price = effective_original_line_price | plus: bundle_addon_original_line_price | plus: hidden_base_original_line_price %}
                  {% assign cart_display_image = item.image %}
                  {% if item.variant.featured_image == blank and item.product.featured_media.preview_image != blank %}
                    {% assign cart_display_image = item.product.featured_media.preview_image %}
                  {% endif %}
                  {% assign image_source_item = item %}
                  {% if cart_display_image %}
                    {% assign _cdi_src = cart_display_image.src | default: '' %}
                    {% if _cdi_src contains 'Newness' or _cdi_src contains 'newness' %}
                      {% for _fb_media in item.product.media %}
                        {% assign _fb_src = _fb_media.preview_image.src | default: '' %}
                        {% unless _fb_src contains 'Newness' or _fb_src contains 'newness' %}
                          {% assign cart_display_image = _fb_media.preview_image %}
                          {% break %}
                        {% endunless %}
                      {% endfor %}
                    {% endif %}
                  {% endif %}
                  {% assign image_source_from_linked_component = false %}
                  {% assign current_item_letter_value = item.properties._letter_charm | default: item.properties['Letter Charms'] | default: item.properties['Letter Charm'] | default: item.properties._letter_charm_selection | strip %}
                  {% if current_item_letter_value == blank %}
                    {% assign current_item_letter_value = item.properties._selected_letter | strip %}
                  {% endif %}
                  {% assign current_item_letter_value = current_item_letter_value | upcase %}
                  {% assign cart_grouped_media_enabled = false %}
                  {% if item.product.tags contains 'vimgord' or item.product.tags contains 'ph-chain-grouped-media' %}
                    {% assign cart_grouped_media_enabled = true %}
                  {% endif %}
                  {% assign current_item_has_grouped_media = false %}
                  {% if cart_grouped_media_enabled and item.product.media.size > 0 %}
                    {% for media in item.product.media %}
                      {% assign current_item_media_alt_compact = media.alt | default: '' | downcase | replace: ' ', '' %}
                      {% if current_item_media_alt_compact contains 'group:' %}
                        {% assign current_item_has_grouped_media = true %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                  {% if current_item_letter_value != blank and current_item_letter_value != 'NO LETTER' and current_item_has_grouped_media == false and item.properties._linked_parent_handle == blank %}
                    {% assign item_lc_bundle_key_for_image = item.properties._lc_bundle_key | default: '' %}
                    {% assign item_ph_bundle_key_for_image = item.properties._ph_bundle_key | default: '' %}
                    {% for linked_component_item in cart.items %}
                      {% if linked_component_item.key != item.key and linked_component_item.properties._linked_parent_product != blank and linked_component_item.properties._selected_letter != blank %}
                        {% assign linked_matches_parent = false %}
                        {% if item_lc_bundle_key_for_image != blank and linked_component_item.properties._lc_bundle_key == item_lc_bundle_key_for_image %}
                          {% assign linked_matches_parent = true %}
                        {% endif %}
                        {% if linked_matches_parent == false and item_ph_bundle_key_for_image != blank and linked_component_item.properties._ph_bundle_key == item_ph_bundle_key_for_image %}
                          {% assign linked_matches_parent = true %}
                        {% endif %}
                        {% if linked_matches_parent == false and linked_component_item.properties._linked_parent_product == item.product.title %}
                          {% assign linked_matches_parent = true %}
                        {% endif %}
                        {% assign linked_selected_letter = linked_component_item.properties._selected_letter | strip | upcase %}
                        {% if linked_matches_parent and linked_selected_letter == current_item_letter_value %}
                          {% assign image_source_item = linked_component_item %}
                          {% assign cart_display_image = linked_component_item.image %}
                          {% assign image_source_from_linked_component = true %}
                          {% break %}
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                  {% assign linked_lc_bundle_key = item.properties._lc_bundle_key | default: '' %}
                  {% if item.properties._linked_parent_product != blank and current_item_has_grouped_media == false %}
                    {% for parent_candidate in cart.items %}
                      {% if parent_candidate.key != item.key %}
                        {% assign parent_candidate_lc_key = parent_candidate.properties._lc_bundle_key | default: '' %}
                        {% assign parent_matches_linked_item = false %}
                        {% if linked_lc_bundle_key != blank and parent_candidate_lc_key == linked_lc_bundle_key and parent_candidate.properties._linked_parent_product == blank %}
                          {% assign parent_matches_linked_item = true %}
                        {% endif %}
                        {% if parent_matches_linked_item == false and parent_candidate.properties._letter_charm != blank and parent_candidate.properties._letter_charm == item.properties._selected_letter %}
                          {% assign parent_matches_linked_item = true %}
                        {% endif %}
                        {% if parent_matches_linked_item %}
                          {% assign image_source_item = parent_candidate %}
                          {% break %}
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                  {% assign product_media_for_cart_image = image_source_item.product.media %}
                  {% if current_item_has_grouped_media %}
                    {% assign product_media_for_cart_image = item.product.media %}
                    {% assign image_source_item = item %}
                  {% endif %}
                  {% assign item_handle_downcase = item.product.handle | default: '' | downcase %}
                  {% if product_media_for_cart_image.size == 0 or item_handle_downcase contains 'letter-pendant' %}
                    {% assign sibling_bundle_key = item.properties._lc_bundle_key | default: item.properties._ph_bundle_key | default: '' %}
                    {% if sibling_bundle_key != blank %}
                      {% for sibling_item in cart.items %}
                        {% if sibling_item.key != item.key %}
                          {% assign sibling_matches_bundle = false %}
                          {% if sibling_item.properties._lc_bundle_key == sibling_bundle_key or sibling_item.properties._ph_bundle_key == sibling_bundle_key %}
                            {% assign sibling_matches_bundle = true %}
                          {% endif %}
                          {% if sibling_matches_bundle %}
                            {% assign sibling_handle_downcase = sibling_item.product.handle | default: '' | downcase %}
                            {% if sibling_handle_downcase contains 'anywear-letter-charm' and sibling_item.product.media.size > 0 %}
                              {% assign sibling_has_grouped_media = false %}
                              {% for sibling_media in sibling_item.product.media %}
                                {% assign sibling_media_alt_compact = sibling_media.alt | default: '' | downcase | replace: ' ', '' %}
                                {% if sibling_media_alt_compact contains 'group:' %}
                                  {% assign sibling_has_grouped_media = true %}
                                  {% break %}
                                {% endif %}
                              {% endfor %}
                              {% if sibling_has_grouped_media %}
                                {% assign image_source_item = sibling_item %}
                                {% assign product_media_for_cart_image = sibling_item.product.media %}
                                {% assign cart_display_image = sibling_item.image %}
                                {% assign cart_grouped_media_enabled = true %}
                                {% break %}
                              {% endif %}
                            {% endif %}
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                    {% endif %}
                  {% endif %}
                  {% assign is_grouped_media_product = false %}
                  {% if cart_grouped_media_enabled and product_media_for_cart_image.size > 0 %}
                    {% for media in product_media_for_cart_image %}
                      {% assign media_alt_compact_probe = media.alt | default: '' | downcase | replace: ' ', '' %}
                      {% if media_alt_compact_probe contains 'group:' %}
                        {% assign is_grouped_media_product = true %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
