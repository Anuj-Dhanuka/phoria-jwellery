{%- comment -%}
  One banner slide for sections/ph-banner-grid.liquid.

  Accepts:
  - image: {Object} Image
  - index: {Number} 1-based slide position (slide 1 loads first, the rest lazily)
  - fallback_alt: {String} Alt text when the image has none
  - attributes: {String} (optional) Theme editor block attributes
{%- endcomment -%}

{%- assign alt = image.alt | default: fallback_alt -%}

<div class="ph-bg-banner__slide swiper-slide" {{ attributes }}>
  {%- comment -%}
    The banner is hidden on desktop (960px+), so desktop gets a 1×1 placeholder instead of
    downloading the photo. Mobile still loads slide 1 first (eager, high priority).
  {%- endcomment -%}
  <picture>
  <source media="(min-width: 960px)" srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" width="1" height="1">
  {%- if index == 1 -%}
    {{
      image
      | image_url: width: 1500
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        widths: '430, 750, 1100, 1500',
        sizes: '100vw',
        alt: alt
    }}
  {%- else -%}
    {{
      image
      | image_url: width: 1500
      | image_tag:
        loading: 'lazy',
        widths: '430, 750, 1100, 1500',
        sizes: '100vw',
        alt: alt
    }}
  {%- endif -%}
  </picture>
</div>
