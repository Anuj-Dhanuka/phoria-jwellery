{% comment %}
  	Renders a list of product's price (regular, sale)

  	Accepts:
  	- product: {Object} Product Liquid object (optional)
  	- use_variant: {Boolean} Renders selected or first variant price instead of overall product pricing (optional)
  	- show_badges: {Boolean} Renders 'Sale' and 'Sold Out' tags if the product matches the condition (optional)
  	- price_class: {String} Adds a price class to the price element (optional)

  	Usage:
  {% render 'price', product: product %}
{% endcomment %}
{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif

  assign compare_at_price = target.compare_at_price
  assign compare_at_price_min_raw = target.compare_at_price_min
  assign compare_at_price_max_raw = target.compare_at_price_max
  if price_override
    assign price = price_override
  else
    assign price = target.price | default: 1999
  endif
  assign price_min_raw = target.price_min
  assign price_max_raw = target.price_max
  assign available = target.available | default: false
  assign money_price = ''
  assign money_compare_at_price = ''
  assign compare_at_price_min = ''
  assign compare_at_price_max = ''
  assign price_min = ''
  assign price_max = ''

  if target == product and product.price_varies
    assign price_varies = true
  else
    assign price_varies = false
  endif
		
  if target == product and product.compare_at_price_varies
    assign compare_price_varies = true
  else
    assign compare_price_varies = false
  endif
		
-%}

<div
  class="
    price
    {%- if price_class %} {{ price_class }}{% endif -%}
    {%- if available == false %} price--sold-out {% endif -%}
    {%- if compare_at_price > price %} price--on-sale {% endif -%}
    {%- if product.price_varies == false and product.compare_at_price_varies %} price--no-compare{% endif -%}
  "
>
  <dl>
    {%- comment -%}
      Explanation of description list:
      - div.price__regular: Displayed when there are no variants on sale
      - div.price__sale: Displayed when a variant is a sale
      - div.price__availability: Displayed when the product is sold out
    {%- endcomment -%}
    <div class="price__regular">
      <dt>
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
      </dt>
      <dd
        {% if show_badges == false %}
          class="price__last"
        {% endif %}
      >
        <span class="price-item price-item--regular">
          {%- if price_varies -%}
            {%- if settings.currency_code_enabled -%}
              {% capture price_min %}{% render 'ph-round-money', amount: price_min_raw, with_currency: true %}{% endcapture %}
              {% capture price_max %}{% render 'ph-round-money', amount: price_max_raw, with_currency: true %}{% endcapture %}
            {%- else -%}
              {% capture price_min %}{% render 'ph-round-money', amount: price_min_raw %}{% endcapture %}
              {% capture price_max %}{% render 'ph-round-money', amount: price_max_raw %}{% endcapture %}
            {%- endif -%}
            {{ price_min | append: ' - ' | append: price_max }}
          {%- else -%}
            {%- if settings.currency_code_enabled -%}
              {% render 'ph-round-money', amount: price, with_currency: true %}
            {%- else -%}
              {% render 'ph-round-money', amount: price %}
            {%- endif -%}
          {%- endif -%}
        </span>
      </dd>
    </div>
    <div class="price__sale">
      <dt class="price__compare">
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
      </dt>
      <dd class="price__compare">
        <s class="price-item price-item--regular">
          {%- if compare_price_varies -%}
            {%- if settings.currency_code_enabled -%}
              {% capture compare_at_price_min %}{% render 'ph-round-money', amount: compare_at_price_min_raw, with_currency: true %}{% endcapture %}
              {% capture compare_at_price_max %}{% render 'ph-round-money', amount: compare_at_price_max_raw, with_currency: true %}{% endcapture %}
            {%- else -%}
              {% capture compare_at_price_min %}{% render 'ph-round-money', amount: compare_at_price_min_raw %}{% endcapture %}
              {% capture compare_at_price_max %}{% render 'ph-round-money', amount: compare_at_price_max_raw %}{% endcapture %}
            {%- endif -%}
            {{ compare_at_price_min | append: ' - ' | append: compare_at_price_max }}
          {%- else -%}
            {%- if settings.currency_code_enabled -%}
              {% render 'ph-round-money', amount: compare_at_price, with_currency: true %}
            {%- else -%}
              {% render 'ph-round-money', amount: compare_at_price %}
            {%- endif -%}
          {%- endif -%}
        </s>
      </dd>
      <dt class="visually-hidden">
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.sale_price' | t }}</span>
      </dt>
      <dd
        {% if show_badges == false %}
          class="price__last"
        {% endif %}
      >
        <span class="price-item price-item--sale">
          {%- if price_varies -%}
            {%- if settings.currency_code_enabled -%}
              {% capture price_min %}{% render 'ph-round-money', amount: price_min_raw, with_currency: true %}{% endcapture %}
              {% capture price_max %}{% render 'ph-round-money', amount: price_max_raw, with_currency: true %}{% endcapture %}
            {%- else -%}
              {% capture price_min %}{% render 'ph-round-money', amount: price_min_raw %}{% endcapture %}
              {% capture price_max %}{% render 'ph-round-money', amount: price_max_raw %}{% endcapture %}
            {%- endif -%}
            {{ price_min | append: ' - ' | append: price_max }}
          {%- else -%}
            {%- if settings.currency_code_enabled -%}
              {% render 'ph-round-money', amount: price, with_currency: true %}
            {%- else -%}
              {% render 'ph-round-money', amount: price %}
            {%- endif -%}
          {%- endif -%}
        </span>
      </dd>
      
    </div>
    <dl class="unit-price caption{% if product.selected_or_first_available_variant.unit_price_measurement == nil %} hidden{% endif %}">
      <dt class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</dt>
      <dd
        {% if show_badges == false %}
          class="price__last"
        {% endif %}
      >
        <span>{% render 'ph-round-money', amount: product.selected_or_first_available_variant.unit_price %}</span>
        <span aria-hidden="true">/</span>
        <span class="visually-hidden">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
        <span>
          {%- if product.selected_or_first_available_variant.unit_price_measurement.reference_value != 1 -%}
            {{- product.selected_or_first_available_variant.unit_price_measurement.reference_value -}}
          {%- endif -%}
          {{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
        </span>
      </dd>
    </dl>
  </dl>
</div>
